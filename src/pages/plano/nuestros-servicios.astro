---
import Base from '../../propuestas/plano/Base.astro';
import { r } from '../../propuestas/plano/config';
import PageHero from '../../propuestas/plano/components/PageHero.astro';
import FotoPendiente from '../../propuestas/plano/components/FotoPendiente.astro';
import IconoServicio from '../../propuestas/comun/IconoServicio.astro';
import Pendiente from '../../propuestas/comun/Pendiente.astro';
import CtaContacto from '../../propuestas/plano/components/CtaContacto.astro';
import { servicios } from '../../data/servicios';
---
<Base title="Servicios" description="Construcción, montaje industrial, mantención, electricidad, voz y datos, y muebles.">
  <PageHero titulo="Nuestros servicios" seccion="Servicios">
    <p>Construcción, montaje industrial, mantención, electricidad, voz y datos, y muebles.</p>
    <ul class="indice-servicios" aria-label="Ir a un servicio">
      {servicios.map((s) => (
        <li><a href={`#${s.slug}`}><IconoServicio nombre={s.icono} />{s.nombre}</a></li>
      ))}
    </ul>
  </PageHero>

  <section class="section">
    <div class="wrap">
      {servicios.map((s, i) => (
        <article class="servicio-fila" id={s.slug} aria-labelledby={`${s.slug}-t`}>
          <div>
            <div class="servicio-fila__cab">
              <IconoServicio nombre={s.icono} />
              <span class="servicio-fila__num">{String(i + 1).padStart(2, '0')} / {String(servicios.length).padStart(2, '0')}</span>
            </div>
            <h2 id={`${s.slug}-t`}>{s.nombre}</h2>
            <div class="servicio-fila__cuerpo">
              {s.descripcion ? (
                <p>{s.descripcion}</p>
              ) : (
                <Pendiente texto="descripción: qué incluye el servicio, para qué tipo de cliente y un ejemplo de obra" bloque />
              )}
              <a class="link-flecha" href={r('terminados')}>Ver proyectos <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <FotoPendiente que={`trabajo de ${s.nombre.toLowerCase()}`} proporcion="3 / 2" medida="mín. 1600 × 1067 px" />
        </article>
      ))}
    </div>
  </section>

  <CtaContacto />
</Base>
