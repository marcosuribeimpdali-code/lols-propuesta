---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pendiente from '../components/Pendiente.astro';
import Revisar from '../components/Revisar.astro';
import { empresa } from '../data/empresa';

const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(empresa.direccion.valor)}`;
---
<Base title="Contacto" description="Contacte a LOLS Ingeniería: dirección, teléfono y correo.">
  <PageHero titulo="Contacto" seccion="Contacto">
    <p>Cuéntenos de su proyecto y le responderemos.</p>
  </PageHero>

  <section class="section">
    <div class="wrap contacto-grid">
      <div>
        <h2 class="visually-hidden">Datos de contacto</h2>
        <dl class="datos">
          <div class="dato">
            <dt>Dirección</dt>
            <dd>
              {empresa.direccion.valor}
              <a class="link-flecha" href={mapa} target="_blank" rel="noopener">Ver en el mapa <span aria-hidden="true">↗</span><span class="visually-hidden">(se abre en otra pestaña)</span></a>
              <Revisar nota={empresa.direccion.revisar} />
            </dd>
          </div>
          <div class="dato">
            <dt>Teléfono</dt>
            <dd>
              <a href={empresa.telefonoHref}>{empresa.telefono.valor}</a>
              <Revisar nota={empresa.telefono.revisar} />
            </dd>
          </div>
          <div class="dato">
            <dt>Correo</dt>
            <dd>
              <a href={`mailto:${empresa.correo.valor}`}>{empresa.correo.valor}</a>
              <Revisar nota={empresa.correo.revisar} />
            </dd>
          </div>
          <div class="dato">
            <dt>Horario de atención</dt>
            <dd><Pendiente texto="días y horario" /></dd>
          </div>
        </dl>
      </div>

      <form class="form" id="form-contacto" method="post" aria-labelledby="form-t" aria-describedby="form-req">
        <h2 id="form-t" class="form__t">Escríbanos</h2>
        <p id="form-req" class="form__req">Todos los campos son obligatorios, salvo los marcados como opcionales.</p>

        <div class="form__fila">
          <div class="campo">
            <label for="f-nombre">Nombre</label>
            <input id="f-nombre" name="nombre" type="text" autocomplete="name" required />
          </div>
          <div class="campo">
            <label for="f-empresa">Empresa <span class="campo__op">(opcional)</span></label>
            <input id="f-empresa" name="empresa" type="text" autocomplete="organization" />
          </div>
        </div>
        <div class="form__fila">
          <div class="campo">
            <label for="f-correo">Correo</label>
            <input id="f-correo" name="correo" type="email" autocomplete="email" required />
          </div>
          <div class="campo">
            <label for="f-telefono">Teléfono <span class="campo__op">(opcional)</span></label>
            <input id="f-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" />
          </div>
        </div>
        <div class="campo">
          <label for="f-mensaje">Mensaje</label>
          <textarea id="f-mensaje" name="mensaje" rows="6" required></textarea>
        </div>

        <!-- Ley 21.719: consentimiento explícito, casilla SIN marcar por defecto -->
        <div class="consent">
          <input id="f-consent" name="consentimiento" type="checkbox" required />
          <label for="f-consent">
            Acepto que {empresa.nombreCorto} use estos datos solo para responder mi consulta, según su{' '}
            <a href="/politica-de-privacidad/">política de privacidad</a>.
          </label>
        </div>

        <Pendiente texto="definir a qué correo llegan los mensajes y validar el texto legal" bloque />

        <button class="btn btn--primary" type="submit">Enviar mensaje <span aria-hidden="true">→</span></button>

        <p class="form__estado" id="form-estado" role="status" tabindex="-1" hidden></p>
      </form>
    </div>
  </section>
</Base>

<script>
  // Propuesta: el formulario todavía no está conectado. No envía ni guarda nada; solo muestra
  // cómo respondería. La validación (campos obligatorios, correo, casilla) la hace el navegador.
  const form = document.getElementById('form-contacto') as HTMLFormElement | null;
  const estado = document.getElementById('form-estado');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!estado) return;
    estado.textContent =
      'Gracias. Esto es una propuesta: el formulario aún no envía mensajes. En el sitio final, aquí se confirmaría la recepción.';
    estado.hidden = false;
    estado.focus();
  });
</script>
