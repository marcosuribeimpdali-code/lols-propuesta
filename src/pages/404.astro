---
// Se compila como /404.html; el .htaccess lo usa como ErrorDocument para todo el sitio.
import Base from '../propuestas/selector/Base.astro';
import Logo from '../propuestas/comun/Logo.astro';
import { principal, propuestas } from '../propuestas/registro';
---
<Base title="Página no encontrada · LOLS Ingeniería">
  <div class="sel">
    <Logo class="sel__logo" />
    <p class="sel__eyebrow">Error 404</p>
    <h1>Esta página no existe.</h1>
    <p class="sel__lead">Puede que la dirección esté mal escrita o que la página se haya movido.</p>
    <ul class="sel__links">
      {principal ? (
        <>
          <li><a href="/">Ir al inicio</a></li>
          <li><a href="/contacto/">Contacto</a></li>
        </>
      ) : (
        <>
          <li><a href="/">Ver las propuestas</a></li>
          {propuestas.map((p) => <li><a href={`/${p.slug}/`}>{p.numero} · {p.nombre}</a></li>)}
        </>
      )}
    </ul>
  </div>
</Base>
