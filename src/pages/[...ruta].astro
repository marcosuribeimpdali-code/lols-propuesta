---
// Ruta única del sitio: arma todas las páginas según `principal` (src/propuestas/registro.ts).
//   principal = 'panoramica' → /, /quienes-somos/, /contacto/… con esa propuesta
//   principal = null         → / (portada para elegir) + /plano/…, /panoramica/…
// Más una ficha por obra finalizada: /proyectos-terminados/<slug>/ (en las propuestas que la
// tienen, ver fichasDe en src/propuestas/paginas.ts).
import type { GetStaticPaths } from 'astro';
import Portada from '../propuestas/selector/Portada.astro';
import { principal, propuestas } from '../propuestas/registro';
import { paginasDe, fichasDe } from '../propuestas/paginas';
import { paginas, type Pagina } from '../data/rutas';
import { conFicha } from '../data/proyectos';

export const getStaticPaths = (() => {
  const claves = Object.keys(paginas) as Pagina[];
  const ruta = (...partes: string[]) =>
    partes.map((x) => x.replace(/^\/+|\/+$/g, '')).filter(Boolean).join('/') || undefined;
  // fichas de obra de una propuesta, bajo su prefijo
  const fichas = (slug: string, prefijo: string) =>
    fichasDe[slug]
      ? conFicha().map((o, indice) => ({
          params: { ruta: ruta(prefijo, paginas.terminados, o.slug!) },
          props: { slug, clave: 'ficha' as const, indice },
        }))
      : [];

  if (principal) {
    return [
      ...claves.map((clave) => ({ params: { ruta: ruta(paginas[clave]) }, props: { slug: principal, clave } })),
      ...fichas(principal, ''),
    ];
  }
  return [
    { params: { ruta: undefined }, props: { slug: null, clave: null } },
    ...propuestas.flatMap((p) => [
      ...claves.map((clave) => ({ params: { ruta: ruta(p.slug, paginas[clave]) }, props: { slug: p.slug, clave } })),
      ...fichas(p.slug, p.slug),
    ]),
  ];
}) satisfies GetStaticPaths;

const { slug, clave, indice } = Astro.props as {
  slug: string | null;
  clave: Pagina | 'ficha' | null;
  indice?: number;
};
const Pagina = slug && clave ? (clave === 'ficha' ? fichasDe[slug] : paginasDe[slug][clave]) : null;
---
{Pagina ? <Pagina indice={indice} /> : <Portada />}
