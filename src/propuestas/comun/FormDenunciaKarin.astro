---
// Canal de denuncias, vía 2: Ley Karin (21.643) — acoso laboral, acoso sexual y violencia en el
// trabajo. Va con nombre, como en la mayoría de las constructoras revisadas: sin datos no se
// pueden tomar medidas de resguardo ni seguir el procedimiento. La persona también puede
// presentarla en la Inspección del Trabajo (lo dice la página).
// Propuesta: NO envía ni guarda nada todavía.
import Adjuntos from './Adjuntos.astro';
import { adjuntosDenuncia as lim, mb } from '../../data/adjuntos';
import { tiposKarin, relaciones } from '../../data/denuncias';

interface Props {
  privacidadHref: string;
}
const { privacidadHref } = Astro.props;

const vinculos = ['Jefatura', 'Compañero o compañera de trabajo', 'Persona a mi cargo', 'Cliente, proveedor o un tercero', 'Otro'];
---
<form class="form" id="form-karin" method="post" enctype="multipart/form-data" aria-labelledby="karin-t" aria-describedby="karin-req">
  <h3 id="karin-t" class="form__t">Denunciar acoso o violencia en el trabajo</h3>
  <p id="karin-req" class="form__req">
    Para investigar y tomar medidas de resguardo necesitamos sus datos. Todo es obligatorio, salvo lo marcado como opcional.
  </p>

  <div class="form__fila">
    <div class="campo">
      <label for="karin-nombre">Nombre completo</label>
      <input id="karin-nombre" name="nombre" type="text" autocomplete="name" required />
    </div>
    <div class="campo">
      <label for="karin-rut">RUT</label>
      <input id="karin-rut" name="rut" type="text" autocomplete="off" inputmode="text" required aria-describedby="karin-rut-ayuda" />
      <p id="karin-rut-ayuda" class="campo__ayuda">Por ejemplo, 12.345.678-9</p>
    </div>
  </div>
  <div class="form__fila">
    <div class="campo">
      <label for="karin-correo">Correo</label>
      <input id="karin-correo" name="correo" type="email" autocomplete="email" required />
    </div>
    <div class="campo">
      <label for="karin-telefono">Teléfono <span class="campo__op">(opcional)</span></label>
      <input id="karin-telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" />
    </div>
  </div>
  <div class="campo">
    <label for="karin-relacion">Su relación con LOLS</label>
    <select id="karin-relacion" name="relacion" required>
      <option value="">Elegir…</option>
      {relaciones.map((x) => <option>{x}</option>)}
    </select>
  </div>

  <fieldset class="campo campo--grupo">
    <legend class="campo__label">¿Usted es la persona afectada?</legend>
    <div class="chips">
      <label class="chip">
        <input type="radio" name="afectado" value="si" required />
        <span>Sí</span>
      </label>
      <label class="chip">
        <input type="radio" name="afectado" value="no" data-por-otro />
        <span>No, denuncio por otra persona</span>
      </label>
    </div>
  </fieldset>
  <div class="campo" data-otra-persona>
    <label for="karin-afectado">Nombre de la persona afectada</label>
    <input id="karin-afectado" name="nombre-afectado" type="text" />
  </div>

  <fieldset class="campo campo--grupo">
    <legend class="campo__label">¿Qué ocurrió?</legend>
    <div class="chips">
      {tiposKarin.map((t, i) => (
        <label class="chip">
          <input type="radio" name="tipo" value={t.valor} required={i === 0} />
          <span>{t.texto}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="form__fila">
    <div class="campo">
      <label for="karin-denunciado">¿Quién lo hizo?</label>
      <input id="karin-denunciado" name="denunciado" type="text" required aria-describedby="karin-denunciado-ayuda" />
      <p id="karin-denunciado-ayuda" class="campo__ayuda">Nombre, o una descripción si no lo sabe (cargo, empresa, obra).</p>
    </div>
    <div class="campo">
      <label for="karin-vinculo">Su relación con esa persona <span class="campo__op">(opcional)</span></label>
      <select id="karin-vinculo" name="vinculo">
        <option value="">Elegir…</option>
        {vinculos.map((x) => <option>{x}</option>)}
      </select>
    </div>
  </div>

  <div class="form__fila">
    <div class="campo">
      <label for="karin-lugar">¿Dónde ocurrió?</label>
      <input id="karin-lugar" name="lugar" type="text" required />
    </div>
    <div class="campo">
      <label for="karin-fecha">¿Cuándo? <span class="campo__op">(opcional, aproximado)</span></label>
      <input id="karin-fecha" name="fecha" type="date" />
    </div>
  </div>

  <div class="campo">
    <label for="karin-relato">Cuéntenos los hechos</label>
    <textarea id="karin-relato" name="relato" rows="6" required aria-describedby="karin-relato-ayuda"></textarea>
    <p id="karin-relato-ayuda" class="campo__ayuda">Qué pasó, cuántas veces y si sigue ocurriendo.</p>
  </div>

  <div class="campo">
    <label for="karin-testigos">Testigos <span class="campo__op">(opcional)</span></label>
    <textarea id="karin-testigos" name="testigos" rows="2"></textarea>
  </div>

  <Adjuntos id="karin-archivos" name="evidencia" label="Evidencia" limites={lim} opcional>
    Fotos, capturas, mensajes, audios o documentos: hasta {lim.maxArchivos} archivos de {mb(lim.maxArchivo)} cada uno
    ({mb(lim.maxTotal)} en total).
  </Adjuntos>

  <fieldset class="campo campo--grupo">
    <legend class="campo__label">¿Quiere que le ofrezcamos atención psicológica temprana? <span class="campo__op">(opcional)</span></legend>
    <div class="chips">
      <label class="chip"><input type="radio" name="apoyo" value="si" /><span>Sí</span></label>
      <label class="chip"><input type="radio" name="apoyo" value="no" /><span>No</span></label>
    </div>
  </fieldset>

  <div class="consent">
    <input id="karin-veraz" name="veraz" type="checkbox" required />
    <label for="karin-veraz">
      Declaro que lo que informo es verdadero según lo que sé, y que leí cómo se tratan estos datos en la{' '}
      <a href={privacidadHref}>política de privacidad</a>.
    </label>
  </div>

  <button class="btn btn--primary" type="submit">Enviar denuncia <span aria-hidden="true">→</span></button>

  <p class="form__estado" id="karin-estado" role="status" tabindex="-1" hidden></p>
</form>

<script>
  const form = document.getElementById('form-karin') as HTMLFormElement | null;
  if (form) {
    const bloque = form.querySelector<HTMLElement>('[data-otra-persona]')!;
    const campo = bloque.querySelector<HTMLInputElement>('input')!;
    const estado = document.getElementById('karin-estado')!;

    // el nombre de la persona afectada se pide solo si denuncia por otra persona
    const aplicar = () => {
      const porOtro = form.querySelector<HTMLInputElement>('[data-por-otro]')!.checked;
      bloque.hidden = !porOtro;
      campo.required = porOtro;
      if (!porOtro) campo.value = '';
    };
    form.querySelectorAll('input[name="afectado"]').forEach((r) => r.addEventListener('change', aplicar));
    aplicar();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      estado.textContent =
        'Gracias. Esto es una propuesta: el canal aún no recibe denuncias. En el sitio final, aquí aparecería su folio y le escribiríamos al correo que indicó.';
      estado.hidden = false;
      estado.focus();
    });
  }
</script>
