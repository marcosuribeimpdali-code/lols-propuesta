---
// Cuerpo compartido de /proyectos-terminados/, /proyectos-en-construccion/ y /proyectos-futuros/.
import ObraCard from './ObraCard.astro';
import Pendiente from '../../comun/Pendiente.astro';
import Revisar from '../../comun/Revisar.astro';
import { porEstado, TIPOS_OBRA, type Estado } from '../../../data/proyectos';
import { r } from '../config';

interface Props {
  estado: Estado;
}
const { estado } = Astro.props;
const lista = porEstado(estado);
const tabs = [
  { href: r('terminados'), label: 'Finalizados', n: porEstado('terminado').length, activo: estado === 'terminado' },
  { href: r('construccion'), label: 'En ejecución', n: porEstado('en-construccion').length, activo: estado === 'en-construccion' },
  { href: r('futuros'), label: 'Próximos proyectos', n: porEstado('futuro').length, activo: estado === 'futuro' },
];
// filtro por tipo de obra (06-10-2026): solo los tipos que tienen obras en esta pestaña; si hay
// menos de dos, no se muestra
const tipos = TIPOS_OBRA.map((t) => ({ t, n: lista.filter((p) => p.tipos.includes(t)).length })).filter((x) => x.n > 0);
---
<section class="pn-sec">
  <div class="wrap">
    <nav class="pn-tabs" aria-label="Tipo de proyecto">
      {tabs.map((t) => (
        <a href={t.href} aria-current={t.activo ? 'page' : undefined}>
          {t.label} <span class="pn-tabs__n">{t.n}</span>
        </a>
      ))}
    </nav>

    {estado === 'futuro' ? (
      <div class="pn-aviso solo-marca">
        <p>Estos dos proyectos son <strong>de ejemplo</strong> (inventados), para ver cómo se ve la sección: se reemplazan por los reales.</p>
        <p>Las imágenes son referenciales (Unsplash) y el plano de cada una sale de la misma imagen.</p>
        <Pendiente texto="futuros proyectos reales de LOLS y sus fechas de inicio" bloque />
      </div>
    ) : (
    <div class="pn-aviso solo-marca">
      <p>
        Las imágenes vienen del sitio de 2018, que mostraba estas obras sin datos; son de baja
        resolución y se reemplazan cuando lleguen fotos actuales.
        {estado === 'en-construccion' && <> Las de esta sección son renders, no fotos. </>}
      </p>
      <p>Los nombres y datos de estas obras son <strong>de ejemplo</strong>, para ver cómo quedan las fichas: se reemplazan por los reales.</p>
      {estado === 'en-construccion' && <p class="solo-marca"><Revisar nota="son obras de 2018: confirmar si siguen en ejecución" /></p>}
      <Pendiente texto="listado actualizado de obras (lo está reuniendo la jefatura)" bloque />
    </div>
    )}

    {tipos.length > 1 && (
      <div class="pn-filtro" role="group" aria-label="Filtrar las obras por tipo">
        <span class="pn-filtro__rot" aria-hidden="true">Tipo de obra</span>
        <button type="button" data-tipo="" aria-pressed="true">Todas <span>{lista.length}</span></button>
        {tipos.map(({ t, n }) => (
          <button type="button" data-tipo={t} aria-pressed="false">{t} <span>{n}</span></button>
        ))}
        <p class="visually-hidden" aria-live="polite" data-filtro-anuncio></p>
      </div>
    )}

    <div class="pn-obras-grid">
      {lista.map((p, i) => (
        <div class="pn-obra-filtro" data-tipos={p.tipos.join('|')}>
          <ObraCard proyecto={p} numero={i + 1} nivel="h2" />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // filtro por tipo: muestra solo las obras del tipo elegido ("Todas" las vuelve a mostrar)
  document.querySelectorAll<HTMLElement>('.pn-filtro').forEach((filtro) => {
    const botones = [...filtro.querySelectorAll<HTMLButtonElement>('button')];
    const obras = [...document.querySelectorAll<HTMLElement>('.pn-obra-filtro')];
    const anuncio = filtro.querySelector<HTMLElement>('[data-filtro-anuncio]');
    botones.forEach((b) =>
      b.addEventListener('click', () => {
        const tipo = b.dataset.tipo ?? '';
        botones.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        let n = 0;
        obras.forEach((o) => {
          const ver = !tipo || (o.dataset.tipos ?? '').split('|').includes(tipo);
          o.hidden = !ver;
          if (ver) n++;
        });
        if (anuncio) anuncio.textContent = `${n} ${n === 1 ? 'obra' : 'obras'}${tipo ? ` de ${tipo.toLowerCase()}` : ''}`;
      }),
    );
  });
</script>
