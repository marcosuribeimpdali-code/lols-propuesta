---
// Cabecera "muro de obras" de Contacto (30-09-2026): columnas con las fotos de las obras
// finalizadas que suben y bajan sin parar detrás del título, para que el que viene a cotizar vea
// de entrada lo que LOLS ya construyó. Usa las fotos reales del sitio de 2018: son chicas, pero a
// este tamaño se ven bien. Reemplazó a "del plano a la obra" (BannerPlano), que pasó a las fichas.
// Se puede pausar (todo lo que se mueve más de 5 s debe poder detenerse) y sin movimiento para
// quien lo pidió en su sistema. El único <h1> de la página vive aquí, como en PageBanner.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { r } from '../config';

interface Props {
  titulo: string;
  antetitulo: string;
  fotos: ImageMetadata[];
}
const { titulo, antetitulo, fotos } = Astro.props;
// cada columna parte en otra foto, para que dos vecinas no muestren la misma a la vez
const COLUMNAS = 5;
const salto = Math.max(1, Math.round(fotos.length / COLUMNAS) + 1);
const columnas = Array.from({ length: COLUMNAS }, (_, k) => fotos.map((_, i) => fotos[(i + k * salto) % fotos.length]));
const duraciones = [62, 74, 56, 68, 80];
---
<section class="pn-banner pn-banner--muro" data-muro>
  <div class="pn-muro" aria-hidden="true">
    {columnas.map((col, k) => (
      <div class="pn-muro__col" style={`--dur: ${duraciones[k % duraciones.length]}s`}>
        {[...col, ...col].map((src) => (
          <Image class="pn-muro__foto" src={src} alt="" widths={[src.width]} sizes="200px" loading="eager" draggable="false" />
        ))}
      </div>
    ))}
  </div>
  <div class="pn-banner__velo" aria-hidden="true"></div>
  <div class="wrap pn-banner__in">
    <nav aria-label="Migas de pan" class="pn-migas">
      <a href={r('inicio')}>Inicio</a> <span aria-hidden="true">›</span> <span aria-current="page">{titulo}</span>
    </nav>
    <p class="pn-banner__ante">{antetitulo}</p>
    <h1>{titulo}</h1>
    <span class="pn-banner__raya" aria-hidden="true"></span>
    {Astro.slots.has('default') && <div class="pn-banner__lead"><slot /></div>}
  </div>
  <button type="button" class="pn-muro__pausa">
    <span class="pn-muro__pausa-icono" aria-hidden="true"></span><span class="pn-muro__pausa-txt">Pausar</span>
  </button>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-muro]').forEach((raiz) => {
    const boton = raiz.querySelector<HTMLButtonElement>('.pn-muro__pausa')!;
    const texto = boton.querySelector('.pn-muro__pausa-txt')!;
    boton.addEventListener('click', () => {
      const pausado = raiz.classList.toggle('is-pausado');
      texto.textContent = pausado ? 'Seguir' : 'Pausar';
    });
  });
</script>
