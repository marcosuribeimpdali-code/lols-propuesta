---
// Cabecera "del plano a la obra" (opción H de la comparación de portadas, 30-09-2026): la foto de
// una obra terminada y su plano de líneas, separados por una línea que el visitante arrastra. Al
// cargar, la línea recorre la foto sola hasta que alguien la toma. Se usa en Contacto, donde el
// visitante viene a cotizar. El plano sale de la misma foto con scripts/plano.mjs (mismo tamaño).
// El único <h1> de la página vive aquí, como en PageBanner.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { r } from '../config';

interface Props {
  titulo: string;
  antetitulo: string;
  foto: ImageMetadata;
  plano: ImageMetadata;
  alt: string;
  /** crédito si la foto es de stock */
  referencial?: string;
}
const { titulo, antetitulo, foto, plano, alt, referencial } = Astro.props;
---
<section class="pn-banner pn-banner--plano" data-plano>
  <Image class="pn-banner__img" src={foto} alt={alt} widths={[640, 1280, 2000]} sizes="100vw" loading="eager" draggable="false" />
  <Image class="pn-banner__img pn-banner__img--plano" src={plano} alt="" widths={[640, 1280, 2000]} sizes="100vw" loading="eager" draggable="false" />
  <div class="pn-banner__velo" aria-hidden="true"></div>
  <div class="pn-banner__linea" aria-hidden="true"></div>
  <span class="pn-banner__rot pn-banner__rot--plano" aria-hidden="true">Plano</span>
  <span class="pn-banner__rot pn-banner__rot--obra" aria-hidden="true">Obra</span>
  <div class="wrap pn-banner__in">
    <nav aria-label="Migas de pan" class="pn-migas">
      <a href={r('inicio')}>Inicio</a> <span aria-hidden="true">›</span> <span aria-current="page">{titulo}</span>
    </nav>
    <p class="pn-banner__ante">{antetitulo}</p>
    <h1>{titulo}</h1>
    <span class="pn-banner__raya" aria-hidden="true"></span>
    {Astro.slots.has('default') && <div class="pn-banner__lead"><slot /></div>}
  </div>
  <div
    class="pn-banner__manija"
    role="slider"
    tabindex="0"
    aria-label="Comparar el plano con la obra terminada"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="100"
    aria-valuetext="Todo plano"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" /></svg>
  </div>
  <span class="pn-banner__pista" aria-hidden="true">Arrastre</span>
  {referencial && <p class="cubo__ref">Imagen referencial · {referencial}</p>}
</section>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-plano]');
  if (raiz) {
    const manija = raiz.querySelector<HTMLElement>('.pn-banner__manija')!;
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const REPOSO = 58; // dónde queda la línea después del barrido: plano a la izquierda, obra a la derecha
    let corte = 100;
    let tocado = false;
    let arrastrando = false;
    const relojes: number[] = [];

    const poner = (v: number, suave = false) => {
      corte = Math.max(0, Math.min(100, v));
      raiz.classList.toggle('suave', suave);
      raiz.style.setProperty('--corte', `${corte}%`);
      const n = Math.round(corte);
      manija.setAttribute('aria-valuenow', String(n));
      manija.setAttribute('aria-valuetext', n >= 100 ? 'Todo plano' : n <= 0 ? 'Toda la obra' : `${n} % plano, ${100 - n} % obra`);
    };
    const luego = (ms: number, f: () => void) => relojes.push(window.setTimeout(() => !tocado && f(), ms));
    const soltar = () => {
      tocado = true;
      relojes.forEach(clearTimeout);
      raiz.classList.add('tocado');
    };

    // barrido al cargar y, mientras nadie la toque, un vaivén cada tanto para invitar a probarla
    poner(100);
    if (reducido) poner(REPOSO);
    else {
      luego(900, () => poner(0, true));
      luego(3600, () => poner(REPOSO, true));
      const vaiven = (t: number) => {
        luego(t, () => poner(22, true));
        luego(t + 2600, () => poner(REPOSO, true));
        luego(t + 5200, () => vaiven(6000));
      };
      vaiven(10000);
    }

    const desde = (e: PointerEvent) => {
      const r = raiz.getBoundingClientRect();
      return ((e.clientX - r.left) / r.width) * 100;
    };
    raiz.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest('a, button')) return;
      e.preventDefault();
      soltar();
      arrastrando = true;
      raiz.setPointerCapture(e.pointerId);
      poner(desde(e));
    });
    raiz.addEventListener('pointermove', (e) => arrastrando && poner(desde(e)));
    raiz.addEventListener('pointerup', () => (arrastrando = false));
    raiz.addEventListener('pointercancel', () => (arrastrando = false));
    manija.addEventListener('keydown', (e) => {
      const k = e.key;
      const v = k === 'ArrowLeft' || k === 'ArrowDown' ? corte - 5 : k === 'ArrowRight' || k === 'ArrowUp' ? corte + 5 : k === 'Home' ? 0 : k === 'End' ? 100 : null;
      if (v === null) return;
      e.preventDefault();
      soltar();
      poner(v);
    });
  }
</script>
