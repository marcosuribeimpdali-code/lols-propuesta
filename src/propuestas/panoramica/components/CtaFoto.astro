---
// Llamado a contacto sobre foto (como el "¡Construyamos tu sueño, juntos!" de la referencia).
import { Image } from 'astro:assets';
import { r } from '../config';
import { diapositivas } from '../../../data/portada';

const fondo = diapositivas[0];
---
<section class="pn-cta" aria-labelledby="pn-cta-t">
  <Image class="pn-cta__img" src={fondo.img} alt="" widths={[640, 1280, 2000]} sizes="100vw" />
  <div class="pn-cta__velo" aria-hidden="true"></div>
  <div class="wrap pn-cta__in">
    <h2 id="pn-cta-t">Conversemos su próximo proyecto</h2>
    <p>Cuéntenos qué necesita en 3 pasos y lo contactamos.</p>
    <div class="pn-cta__acciones">
      <a class="btn btn--lima" href={r('contacto')}>Cuéntenos su proyecto <span aria-hidden="true">→</span></a>
    </div>
  </div>
  {fondo.referencial && <p class="cubo__ref">Imagen referencial{fondo.credito && ` · ${fondo.credito}`}</p>}
</section>
