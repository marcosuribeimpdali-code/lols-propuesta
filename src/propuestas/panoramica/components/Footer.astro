---
// Pie: sin repetir lo que ya muestra cada página (la lista de servicios está en el menú y en
// Servicios; la invitación a cotizar, en la franja verde de arriba; el lema, en la portada).
// En el celular, abajo queda fija una barra con Llamar y Cotizar.
import Logo from '../../comun/Logo.astro';
import Pendiente from '../../comun/Pendiente.astro';
import { empresa } from '../../../data/empresa';
import { r } from '../config';

const anio = new Date().getFullYear();
---
<footer class="pn-footer">
  <div class="wrap pn-footer__grid">
    <div class="pn-footer__marca">
      <a href={r('inicio')} class="pn-footer__logo" aria-label="LOLS Ingeniería, ir al inicio"><Logo decorativo /></a>
      <p>{empresa.razonSocial}. Santiago, Chile.</p>
    </div>
    <div>
      <h2 class="pn-footer__h">Empresa</h2>
      <ul>
        <li><a href={r('quienes')}>Quiénes somos</a></li>
        <li><a href={r('servicios')}>Servicios</a></li>
        <li><a href={r('maquinaria')}>Maquinaria y equipos</a></li>
        <li><a href={r('terminados')}>Proyectos finalizados</a></li>
        <li><a href={r('construccion')}>Proyectos en ejecución</a></li>
        <li><a href={r('contacto')}>Cuéntenos su proyecto</a></li>
      </ul>
    </div>
    <div>
      <h2 class="pn-footer__h">Trabaje con LOLS</h2>
      <ul>
        <li><a href={r('trabaja')}>Trabaja con nosotros</a></li>
        <li class="pn-footer__pend"><Pendiente texto="registro de proveedores, si se quiere" /></li>
      </ul>
    </div>
    <div>
      <h2 class="pn-footer__h">Contacto</h2>
      <ul>
        <li>{empresa.direccion.valor}</li>
        <li><a href={empresa.telefonoHref}>{empresa.telefono.valor}</a></li>
        <li><a href={`mailto:${empresa.correo.valor}`}>{empresa.correo.valor}</a></li>
      </ul>
      <p class="pn-footer__nota"><span aria-hidden="true">⚠</span> Datos de contacto por confirmar</p>
    </div>
  </div>
  <div class="pn-footer__legal">
    <div class="wrap pn-footer__legal-in">
      <p>© {anio} {empresa.razonSocial} · RUT <Pendiente texto="RUT" /></p>
      <p><a href={r('privacidad')}>Política de privacidad</a> · <a href={r('denuncias')}>Canal de denuncias</a> · Propuesta de sitio en revisión</p>
    </div>
  </div>
</footer>

<nav class="pn-barra-movil" aria-label="Contacto rápido">
  <a class="pn-barra-movil__llamar" href={empresa.telefonoHref}>Llamar</a>
  <a class="pn-barra-movil__cotizar" href={r('contacto')}>Cotizar</a>
</nav>
