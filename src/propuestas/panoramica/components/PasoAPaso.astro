---
// Paso a paso de una obra: Antes → Durante → Después, con botones por etapa (pestañas).
// Sin JS se ven las etapas una bajo otra; con JS, una a la vez con un fundido.
// Teclado: flechas izquierda/derecha, Inicio y Fin entre los botones (patrón de pestañas).
import { Image } from 'astro:assets';
import Pendiente from '../../comun/Pendiente.astro';
import type { Foto } from '../../../data/proyectos';

interface Props {
  etapas: Foto[];
  /** prefijo único para los id de pestañas y paneles */
  id: string;
}
const { etapas, id } = Astro.props;
---
<div class="pap" data-pap>
  <div class="pap__tabs" role="tablist" aria-label="Etapas de la obra">
    {etapas.map((e, i) => (
      <button
        type="button"
        class="pap__tab"
        role="tab"
        id={`${id}-tab-${i}`}
        aria-controls={`${id}-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        <span class="pap__tab-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        {e.etapa}
      </button>
    ))}
  </div>

  <div class="pap__escena">
    {etapas.map((e, i) => {
      // foto chica o vertical (las de 2018 son de 372 px): se muestra entera sobre un fondo
      // desenfocado de sí misma, en vez de estirarla y que se vea pixelada
      const chica = e.src.width < 1000;
      return (
        <figure
          class:list={['pap__panel', { 'is-activo': i === 0, 'pap__panel--chica': chica }]}
          role="tabpanel"
          id={`${id}-panel-${i}`}
          aria-labelledby={`${id}-tab-${i}`}
        >
          <div class="pap__media">
            {chica && <Image class="pap__fondo" src={e.src} alt="" widths={[400]} sizes="400px" />}
            <Image
              class="pap__img"
              src={e.src}
              alt={e.alt}
              widths={[640, 1024, 1600]}
              sizes="(max-width: 1240px) 100vw, 1240px"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            <span class="pap__rotulo">{e.etapa}</span>
            <span class="cubo__ref">{e.ejemplo ? 'Foto de ejemplo' : 'Foto real · sitio lols.cl de 2018'}</span>
          </div>
          <figcaption class="pap__texto">
            <span class="pap__fecha">{e.fecha ?? <Pendiente texto="fecha" />}</span>
            <span>{e.descripcion ?? <Pendiente texto={`qué se hizo en la etapa "${e.etapa.toLowerCase()}"`} />}</span>
          </figcaption>
        </figure>
      );
    })}
  </div>

  <div class="pap__barras" aria-hidden="true">
    {etapas.map((_, i) => <span class:list={['pap__barra', { 'is-hecha': i === 0 }]}></span>)}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pap]').forEach((raiz) => {
    const tabs = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...raiz.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const barras = [...raiz.querySelectorAll<HTMLElement>('.pap__barra')];

    const elegir = (i: number, foco = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => {
        p.classList.toggle('is-activo', k === i);
        p.inert = k !== i;
      });
      barras.forEach((b, k) => b.classList.toggle('is-hecha', k <= i));
      if (foco) tabs[i].focus();
    };

    raiz.classList.add('pap--js');
    elegir(0);
    tabs.forEach((t, i) => t.addEventListener('click', () => elegir(i)));
    raiz.querySelector('[role="tablist"]')?.addEventListener('keydown', (ev) => {
      const e = ev as KeyboardEvent;
      const actual = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      const destino =
        e.key === 'ArrowRight' ? (actual + 1) % tabs.length
        : e.key === 'ArrowLeft' ? (actual - 1 + tabs.length) % tabs.length
        : e.key === 'Home' ? 0
        : e.key === 'End' ? tabs.length - 1
        : -1;
      if (destino >= 0) {
        e.preventDefault();
        elegir(destino, true);
      }
    });
  });
</script>
