---
import { Image } from 'astro:assets';
import Pendiente from '../../comun/Pendiente.astro';
import { altObra, type Proyecto } from '../../../data/proyectos';
import { rObra } from '../config';

interface Props {
  proyecto: Proyecto;
  numero: number;
  nivel?: 'h2' | 'h3';
}
const { proyecto: p, numero, nivel: H = 'h3' } = Astro.props;

const n = String(numero).padStart(2, '0');
// obras con ficha: toda la tarjeta lleva a ella (enlace "estirado" sobre la tarjeta)
const href = p.slug ? rObra(p.slug, p.estado) : null;
// mismos rótulos que usaba el sitio de 2018 sobre cada obra (y el mes de inicio en las futuras)
const cinta = p.estado === 'terminado' ? 'Entregado' : p.estado === 'futuro' ? `Inicio ${p.inicio}` : 'Próxima entrega';
const campos: [string, string | null][] = [
  ['Mandante', p.mandante],
  ['Comuna', p.comuna],
  p.estado === 'terminado' ? ['Año', p.anio] : p.estado === 'futuro' ? ['Inicio', p.inicio] : ['Entrega estimada', p.entregaEstimada],
  ['Servicios', p.servicios?.join(' · ') ?? null],
  ['Magnitud', p.magnitud],
];
---
<article class:list={['pn-obra', { 'pn-obra--link': href }]}>
  <div class="pn-obra__media">
    {p.imagen ? (
      <Image class="pn-obra__img" src={p.imagen.src} alt={altObra(p, numero)} widths={[372, 744]} sizes="(max-width: 640px) 100vw, 372px" />
    ) : (
      <div class="pn-obra__vacia" role="img" aria-label={`Foto pendiente de la obra ${n}`}><Pendiente texto="foto de la obra" /></div>
    )}
    <span class:list={['pn-obra__cinta', `pn-obra__cinta--${p.estado}`]}>{cinta}</span>
    {href && <span class="pn-obra__hover" aria-hidden="true">{p.estado === 'terminado' ? 'Ver el paso a paso' : p.estado === 'futuro' ? 'Ver el proyecto' : 'Ver el avance'}</span>}
    {p.imagen && <span class="pn-obra__origen">{p.imagen.tipo === 'render' ? 'Render' : p.imagen.tipo === 'referencial' ? 'Imagen referencial' : 'Foto'} · {p.imagen.origen}</span>}
  </div>
  <div class="pn-obra__cuerpo">
    <span class="pn-obra__num">Obra {n}{p.datosEjemplo && <span class="pn-ej">Datos de ejemplo</span>}</span>
    <H class:list={['pn-obra__titulo', { 'solo-marca': !p.nombre }]}>
      {href ? (
        <a class="pn-obra__link" href={href}>{p.nombre ?? <><span class="visually-hidden">Obra {n}: </span><Pendiente texto="nombre de la obra" /></>}</a>
      ) : (
        p.nombre ?? <Pendiente texto="nombre de la obra" />
      )}
    </H>
    <dl class="pn-ficha">
      {campos.map(([k, v]) => (
        <div class:list={{ 'solo-marca': !v }}>
          <dt>{k}</dt>
          <dd>{v ?? <span class="pendiente pendiente--mini">pendiente</span>}</dd>
        </div>
      ))}
    </dl>
    {p.avance !== null && (
      <div class="pn-obra__avance">
        <span class="pn-obra__avance-txt">Avance {p.avance} %</span>
        <span class="pn-obra__avance-barra" aria-hidden="true"><span style={`width: ${p.avance}%`}></span></span>
      </div>
    )}
    {href && <span class="pn-link pn-obra__ver" aria-hidden="true">{p.estado === 'futuro' ? 'Ver proyecto →' : 'Ver obra →'}</span>}
  </div>
</article>
