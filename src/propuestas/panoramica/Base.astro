---
// Propuesta 2 · Panorámica. Colores del sitio lols.cl de 2018 (verde #168D3A, lima #81D742,
// negro) y portada a pantalla completa con fotos que giran en cubo 3D.
// Fuentes empaquetadas con el sitio (no Google Fonts): no envían la IP de las visitas a terceros.
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource-variable/dm-sans';
import { VERSION } from '../../data/version';
import BarraPropuesta from '../comun/BarraPropuesta.astro';
import ModoMarcas from '../comun/ModoMarcas.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import { SLUG } from './config';
import { listaServicios } from '../../data/servicios';
import { empresa } from '../../data/empresa';

interface Props {
  /** undefined = página de inicio */
  title?: string;
  description?: string;
}
const {
  title,
  description = `${empresa.nombreCorto}: ${empresa.anios} años en el mercado. ${listaServicios}`,
} = Astro.props;
const esPortada = !title;
const fullTitle = title ? `${title} · LOLS Ingeniería` : `LOLS Ingeniería · ${empresa.lema}`;
// vista previa al compartir el enlace (WhatsApp, correo, LinkedIn): foto aérea, logo y el lema.
// La imagen la genera scripts/descargas.mjs (public/compartir.jpg, 1200 × 630).
const url = new URL(Astro.url.pathname, Astro.site);
const imagenCompartir = new URL(`/compartir.jpg?v=${VERSION}`, Astro.site);
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- propuesta en revisión: fuera de los buscadores (también lo dice robots.txt) -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LOLS Ingeniería" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${empresa.nombreCorto}: ${empresa.lema}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- hoja propia de esta propuesta como <link>, no como import: la ruta única del sitio
         importa los componentes de todas y los estilos se mezclarían -->
    <link rel="stylesheet" href={`/estilos/panoramica.css?v=${VERSION}`} />
    <meta name="theme-color" content="#168D3A" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ModoMarcas />
  </head>
  <body class="pn">
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <BarraPropuesta actual={SLUG} />
    <div class="pn-marco">
      <Header sobreFoto={esPortada} />
      <main id="contenido" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
