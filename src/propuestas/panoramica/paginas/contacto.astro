---
import Base from '../Base.astro';
import { r } from '../config';
import BannerPlano from '../components/BannerPlano.astro';
import FormContacto from '../../comun/FormContacto.astro';
import Mapa from '../../comun/Mapa.astro';
import Pendiente from '../../comun/Pendiente.astro';
import Revisar from '../../comun/Revisar.astro';
import IconoWhatsapp from '../../comun/IconoWhatsapp.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import { empresa, mapas, whatsappHref, areas, correoArea } from '../../../data/empresa';
import { despuesDeEnviar, despuesRevisar } from '../../../data/proceso';
// cabecera "del plano a la obra" (opción H): foto de una obra terminada y su plano, que sale de
// la misma foto con scripts/plano.mjs. Stock (Unsplash) hasta tener una obra real de LOLS.
import fotoObra from '../../../assets/contacto/obra-terminada.jpg';
import planoObra from '../../../assets/contacto/obra-terminada-plano.jpg';

// íconos de línea de cada área (mismo trazo que los de arriba)
const iconosArea = ['M6 3h9l3 3v15H6zM15 3v3h3M9 11h6M9 15h6M9 19h4'];
---
<Base title="Contacto" description="Contacte a LOLS Ingeniería: dirección, teléfono y correo.">
  <BannerPlano
    titulo="Contacto"
    antetitulo="Del plano a la obra"
    foto={fotoObra}
    plano={planoObra}
    alt="Edificio de oficinas terminado, con fachada de paneles y jardines"
    referencial="Iracema Navarro / Unsplash"
  >
    <p>Cuéntenos de su proyecto: nosotros lo llevamos del plano a la obra terminada.</p>
  </BannerPlano>

  <section class="pn-sec">
    <div class="wrap">
      <h2 class="visually-hidden">Datos de contacto</h2>
      <ul class="pn-datos">
        <li class="pn-dato">
          <span class="pn-dato__icono" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          </span>
          <h3>Dirección</h3>
          <p>{empresa.direccion.valor}</p>
          <a class="pn-link" href={mapas.ver} target="_blank" rel="noopener">Ver en el mapa <span aria-hidden="true">↗</span><span class="visually-hidden">(se abre en otra pestaña)</span></a>
        </li>
        <li class="pn-dato">
          <span class="pn-dato__icono" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M6.5 3h3l1.5 4.5-2 1.5a11 11 0 0 0 6 6l1.5-2 4.5 1.5v3A2 2 0 0 1 19 19.5 16.5 16.5 0 0 1 4.5 5 2 2 0 0 1 6.5 3Z" /></svg>
          </span>
          <h3>Teléfono</h3>
          <p><a href={empresa.telefonoHref}>{empresa.telefono.valor}</a></p>
          <a class="pn-link pn-link--wa" href={whatsappHref} target="_blank" rel="noopener"><IconoWhatsapp /> Escribir por WhatsApp<span class="visually-hidden"> (se abre en otra pestaña)</span></a>
        </li>
        <li class="pn-dato">
          <span class="pn-dato__icono" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3.5 6 8.5 7 8.5-7" /></svg>
          </span>
          <h3>Correo</h3>
          <p><a href={`mailto:${empresa.correo.valor}`}>{empresa.correo.valor}</a></p>
        </li>
        <li class="pn-dato solo-marca">
          <span class="pn-dato__icono" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          </span>
          <h3>Horario</h3>
          <p><Pendiente texto="días y horario de atención" /></p>
        </li>
      </ul>

      <section class="pn-pasos" aria-labelledby="pasos-t">
        <p class="pn-pasos__ante">Después de enviar</p>
        <h2 id="pasos-t" class="pn-pasos__t">¿Qué pasa con su mensaje? <Revisar nota={despuesRevisar} /></h2>
        <ol class="pn-pasos__lista">
          {despuesDeEnviar.map((p, i) => (
            <li>
              <span class="pn-pasos__n" aria-hidden="true">{i + 1}</span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))}
        </ol>
      </section>

      <div class="pn-contacto">
        <div class="pn-form-caja">
          <FormContacto privacidadHref={r('privacidad')} />
        </div>

        <section class="pn-mapa" aria-labelledby="mapa-t">
          <h2 id="mapa-t">Dónde estamos</h2>
          <Mapa class="pn-mapa__mapa" />
          <p class="pn-mapa__dir">
            <strong>{empresa.razonSocial}</strong><br />
            {empresa.direccion.valor}
          </p>
          <div class="pn-mapa__acciones">
            <a class="btn btn--verde" href={mapas.llegar} target="_blank" rel="noopener">
              Cómo llegar <span aria-hidden="true">↗</span><span class="visually-hidden">(abre Google Maps en otra pestaña)</span>
            </a>
            <a class="pn-link" href={empresa.telefonoHref}>Llamar al {empresa.telefono.valor}</a>
          </div>
          <p class="pn-mapa__cv">¿Busca trabajo? <a href={r('trabaja')}>Envíe su CV aquí</a>.</p>
        </section>
      </div>
    </div>
  </section>

  <section class="pn-sec pn-sec--gris" aria-labelledby="areas-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Contacto por área" titulo="¿Con quién hablar?" id="areas-t">
        <p>Escríbanos con el asunto ya indicado y su mensaje llega directo a quien corresponde.</p>
      </TituloSeccion>
      <ul class="pn-areas">
        {areas.map((a, i) => (
          <li class="pn-dato">
            <span class="pn-dato__icono" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={iconosArea[i % iconosArea.length]} /></svg></span>
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
            <a class="pn-link" href={correoArea(a)}>Escribir <span aria-hidden="true">→</span><span class="visually-hidden">: {a.titulo}</span></a>
          </li>
        ))}
        <li class="pn-dato">
          <span class="pn-dato__icono" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 11a4 4 0 1 0 8 0a4 4 0 1 0-8 0M4 21a8 8 0 0 1 16 0" /></svg></span>
          <h3>Trabaja con nosotros</h3>
          <p>Postulaciones y CV para obra y oficina.</p>
          <a class="pn-link" href={r('trabaja')}>Postular <span aria-hidden="true">→</span></a>
        </li>
      </ul>
    </div>
  </section>
</Base>
