---
import { Image } from 'astro:assets';
import Base from '../Base.astro';
import PageBanner from '../components/PageBanner.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import CtaFoto from '../components/CtaFoto.astro';
import Pendiente from '../../comun/Pendiente.astro';
import Revisar from '../../comun/Revisar.astro';
import { empresa } from '../../../data/empresa';
import { diapositivas } from '../../../data/portada';
import { hitos, certificaciones } from '../../../data/historia';

const banner = diapositivas[2];
const lateral = diapositivas[0];

// sello de 16 puntas para las certificaciones
const sello = Array.from({ length: 32 }, (_, i) => {
  const r = i % 2 ? 19.5 : 23;
  const a = (Math.PI * i) / 16;
  return `${(24 + r * Math.sin(a)).toFixed(2)},${(24 - r * Math.cos(a)).toFixed(2)}`;
}).join(' ');
---
<Base title="Quiénes somos" description="LOLS Ingeniería Limitada: experiencia, seguridad y calidad son nuestras directrices.">
  <PageBanner titulo="Quiénes somos" img={banner.img} referencial={banner.credito ?? undefined} />

  <section class="pn-sec">
    <div class="wrap pn-dos">
      <div class="pn-dos__txt">
        <TituloSeccion antetitulo={empresa.razonSocial} titulo="Sus proyectos en las mejores manos" centrado={false} />
        <p class="pn-grande">{empresa.experiencia.valor} <Revisar nota={empresa.experiencia.revisar} /></p>
        <p>{empresa.principios[0]}</p>
        <p>{empresa.principios[1]}</p>
        <blockquote class="pn-cita">{empresa.directrices}</blockquote>
      </div>
      <figure class="pn-dos__img">
        <Image src={lateral.img} alt={lateral.alt} widths={[600, 1200]} sizes="(max-width: 900px) 100vw, 560px" />
        {lateral.referencial && <figcaption class="cubo__ref">Imagen referencial{lateral.credito && ` · ${lateral.credito}`}</figcaption>}
      </figure>
    </div>
  </section>

  <section class="pn-directrices" aria-labelledby="dir-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Cómo trabajamos" titulo="Nuestras directrices" id="dir-t" claro />
      <ol class="pn-directrices__grid">
        <li>
          <span class="pn-directrices__n">01</span>
          <h3>Experiencia</h3>
          <p>{empresa.experiencia.valor}</p>
          <Revisar nota={empresa.experiencia.revisar} />
        </li>
        <li>
          <span class="pn-directrices__n">02</span>
          <h3>Seguridad</h3>
          <p>{empresa.principios[1]}</p>
        </li>
        <li>
          <span class="pn-directrices__n">03</span>
          <h3>Calidad</h3>
          <p>{empresa.principios[0]}</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="pn-sec" aria-labelledby="hist-t">
    <div class="wrap">
      <TituloSeccion antetitulo={`${empresa.anios} años en la construcción`} titulo="Nuestra historia" id="hist-t" />
      <ol class="pn-linea">
        {hitos.map((h) => (
          <li class:list={['pn-linea__hito', { 'is-ejemplo': h.ejemplo }]}>
            <span class="pn-linea__anio">{h.anio}</span>
            <h3>{h.titulo}</h3>
            <p>{h.texto}</p>
            {h.ejemplo && <span class="pn-ej">Ejemplo</span>}
            <Revisar nota={h.revisar} />
          </li>
        ))}
      </ol>
      <p class="pn-linea__pend">
        <Pendiente texto="los hitos reales: obras, mandantes o cambios que marcaron la trayectoria. Los marcados como Ejemplo son de muestra" bloque />
      </p>
    </div>
  </section>

  <section class="pn-sec pn-sec--gris" aria-labelledby="cert-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Respaldo" titulo="Certificaciones" id="cert-t" />
      <ul class="pn-certs">
        {certificaciones.map((c) => (
          <li class="pn-cert">
            <svg class="pn-cert__sello" viewBox="0 0 48 48" aria-hidden="true">
              <polygon points={sello} />
              <path d="M16 24.5l5.5 5.5L32.5 19" />
            </svg>
            <div>
              <h3>{c.nombre}</h3>
              <p class="pn-cert__area">{c.area}</p>
              <p>{c.texto}</p>
              {c.ejemplo && <span class="pn-ej">Ejemplo</span>}
            </div>
          </li>
        ))}
        <li class="pn-cert pn-cert--vacio">
          <Pendiente
            texto="qué registros, certificaciones o afiliaciones tiene la empresa. Por ejemplo: Registro de Contratistas del MOP o del MINVU, instalador autorizado SEC, socio de la Cámara Chilena de la Construcción"
            bloque
          />
        </li>
      </ul>
    </div>
  </section>

  <CtaFoto />
</Base>
