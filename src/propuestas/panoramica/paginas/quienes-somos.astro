---
// Cada frase institucional aparece una sola vez: la presentación cuenta la empresa con sus datos,
// las directrices van en la banda verde y la trayectoria en la línea de tiempo.
import { Image } from 'astro:assets';
import Base from '../Base.astro';
import PageBanner from '../components/PageBanner.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import CtaFoto from '../components/CtaFoto.astro';
import Pendiente from '../../comun/Pendiente.astro';
import Revisar from '../../comun/Revisar.astro';
import { empresa } from '../../../data/empresa';
import { listaServicios } from '../../../data/servicios';
import { diapositivas } from '../../../data/portada';
import { hitos } from '../../../data/historia';
import { dron } from '../../../data/dron';
import { presentacion } from '../../../data/descargas';

const banner = dron.obraGrua;
const lateral = diapositivas[0];
const servicios = listaServicios.charAt(0).toLowerCase() + listaServicios.slice(1);
---
<Base title="Quiénes somos" description={`${empresa.razonSocial}: ${empresa.anios} años en el área de la construcción.`}>
  <PageBanner titulo="Quiénes somos" img={banner.img} referencial={banner.credito ?? undefined} />

  <section class="pn-sec">
    <div class="wrap pn-dos">
      <div class="pn-dos__txt">
        <TituloSeccion antetitulo={empresa.razonSocial} titulo="Nuestra empresa" centrado={false} />
        <p class="pn-grande">
          Somos una empresa de Santiago con {empresa.anios} años en el área de la construcción y más de
          {' '}{empresa.cifras.obras} obras realizadas.
        </p>
        <p>Hoy somos más de {empresa.cifras.trabajadores} trabajadores en {servicios} <Revisar nota={empresa.cifrasRevisar} /></p>
        <p class="solo-marca"><Pendiente texto="2 o 3 líneas sobre el tipo de obras que hace la empresa y para quién" /></p>
        <a class="btn btn--verde pn-descarga" href={presentacion.href} download={presentacion.nombreArchivo}>
          <svg class="pn-descarga__ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg>
          Descargar presentación
          <span class="pn-descarga__peso">PDF{presentacion.peso && ` · ${presentacion.peso}`}</span>
        </a>
      </div>
      <figure class="pn-dos__img">
        <Image src={lateral.img} alt={lateral.alt} widths={[600, 1200]} sizes="(max-width: 900px) 100vw, 560px" />
        {lateral.referencial && <figcaption class="cubo__ref">Imagen referencial{lateral.credito && ` · ${lateral.credito}`}</figcaption>}
      </figure>
    </div>
  </section>

  <section class="pn-directrices" aria-labelledby="dir-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Lo que nos guía" titulo="Nuestras directrices" id="dir-t" claro>
        <p>{empresa.directrices}</p>
      </TituloSeccion>
      <ol class="pn-directrices__grid">
        <li>
          <span class="pn-directrices__n">01</span>
          <h3>Experiencia</h3>
          <p>Más de {empresa.cifras.obras} obras en {empresa.anios} años.</p>
        </li>
        <li>
          <span class="pn-directrices__n">02</span>
          <h3>Seguridad</h3>
          <p>{empresa.principios[1]}</p>
        </li>
        <li>
          <span class="pn-directrices__n">03</span>
          <h3>Calidad</h3>
          <p>{empresa.principios[0]}</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="pn-sec" aria-labelledby="hist-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Trayectoria" titulo="Nuestra historia" id="hist-t" />
      <ol class="pn-linea">
        {hitos.map((h) => (
          <li class:list={['pn-linea__hito', { 'is-ejemplo': h.ejemplo }]}>
            <span class="pn-linea__anio">{h.anio}</span>
            <h3>{h.titulo}</h3>
            <p>{h.texto}</p>
            {h.ejemplo && <span class="pn-ej">Ejemplo</span>}
            <Revisar nota={h.revisar} />
          </li>
        ))}
      </ol>
      <p class="pn-linea__pend">
        <Pendiente texto="los hitos reales: obras, mandantes o cambios que marcaron la trayectoria. Los marcados como Ejemplo son de muestra" bloque />
      </p>
    </div>
  </section>

  <CtaFoto />
</Base>
