---
import Base from '../Base.astro';
import { r } from '../config';
import PageBanner from '../components/PageBanner.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import CtaFoto from '../components/CtaFoto.astro';
import IconoServicio from '../../comun/IconoServicio.astro';
import Pendiente from '../../comun/Pendiente.astro';
import { servicios, listaServicios, revisarDescripciones } from '../../../data/servicios';
import Revisar from '../../comun/Revisar.astro';
import { diapositivas } from '../../../data/portada';

const banner = diapositivas[1];
---
<Base title="Servicios" description={listaServicios}>
  <PageBanner titulo="Nuestros servicios" img={banner.img} referencial={banner.credito ?? undefined}>
    <p>{listaServicios}</p>
  </PageBanner>

  <section class="pn-sec">
    <div class="wrap">
      <ul class="pn-chips" aria-label="Ir a un servicio">
        {servicios.map((s) => (
          <li><a href={`#${s.slug}`}><IconoServicio nombre={s.icono} />{s.nombre}</a></li>
        ))}
      </ul>
      <p class="pn-serv-nota"><Revisar nota={revisarDescripciones} /></p>

      <div class="pn-serv-lista">
        {servicios.map((s, i) => (
          <article class="pn-serv-item" id={s.slug} aria-labelledby={`${s.slug}-t`}>
            <div class="pn-serv-item__lado">
              <span class="pn-serv-item__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="pn-serv__icono pn-serv__icono--xl"><IconoServicio nombre={s.icono} /></span>
            </div>
            <div class="pn-serv-item__cuerpo">
              <h2 id={`${s.slug}-t`}>{s.nombre}</h2>
              {s.descripcion ? (
                <p>{s.descripcion} <Revisar nota={s.revisar} /></p>
              ) : (
                <Pendiente texto="descripción: qué incluye el servicio, para qué tipo de cliente y un ejemplo de obra" bloque />
              )}
              <Pendiente texto={`foto de un trabajo de ${s.nombre.toLowerCase()}`} />
              <div class="pn-serv-item__acciones">
                <a class="btn btn--verde" href={r('contacto')}>Cotizar<span class="visually-hidden"> {s.nombre.toLowerCase()}</span> <span aria-hidden="true">→</span></a>
                <a class="pn-link" href={r('terminados')}>Ver proyectos <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaFoto />
</Base>
