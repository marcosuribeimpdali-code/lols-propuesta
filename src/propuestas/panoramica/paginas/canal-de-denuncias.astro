---
// Canal de denuncias (ver src/data/denuncias.ts): qué es, garantías, las dos vías, cómo se
// revisa, los formularios, la consulta con folio y otras vías. Sin la franja de "Cotizar" al final:
// esta página no es para vender.
import Base from '../Base.astro';
import { r } from '../config';
import PageBanner from '../components/PageBanner.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import Pendiente from '../../comun/Pendiente.astro';
import FormDenunciaEtica from '../../comun/FormDenunciaEtica.astro';
import FormDenunciaKarin from '../../comun/FormDenunciaKarin.astro';
import { diapositivas } from '../../../data/portada';
import { quienesPueden, garantias, pasos } from '../../../data/denuncias';

const banner = diapositivas[4];
const privacidad = r('privacidad');
---
<Base title="Canal de denuncias" description="Canal para informar, con reserva y sin represalias, conductas que van contra la ley o contra las normas de LOLS Ingeniería.">
  <PageBanner titulo="Canal de denuncias" img={banner.img} referencial={banner.credito ?? undefined}>
    <p>Un espacio seguro para informar conductas que van contra la ley o contra nuestras normas.</p>
  </PageBanner>

  <section class="pn-sec" aria-labelledby="den-que-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Un canal seguro" titulo="¿Quién puede usarlo?" id="den-que-t">
        <p>{quienesPueden}</p>
      </TituloSeccion>

      <ul class="den-garantias">
        {garantias.map((g) => (
          <li>
            <h3>{g.titulo}</h3>
            <p>{g.texto}</p>
          </li>
        ))}
      </ul>

      <p class="den-aviso" role="note">
        <strong>Este canal no atiende emergencias.</strong> Si hay riesgo para alguien, llame al
        {' '}<a href="tel:133">133</a> (Carabineros) o al <a href="tel:131">131</a> (SAMU).
      </p>

      <h2 class="den-h2" id="den-vias-t">Elija el tipo de denuncia</h2>
      <ul class="den-vias" aria-labelledby="den-vias-t">
        <li>
          <a class="den-via" href="#etica">
            <span class="den-via__t">Delitos y faltas a la ética</span>
            <span class="den-via__p">
              Cohecho, fraude, lavado de activos, conflicto de interés, condiciones inseguras, daño al medio
              ambiente, discriminación y otras faltas a la ley o a nuestras normas.
            </span>
            <span class="den-via__nota">Puede ser anónima</span>
            <span class="den-via__ir" aria-hidden="true">Ir al formulario →</span>
          </a>
        </li>
        <li>
          <a class="den-via" href="#karin">
            <span class="den-via__t">Acoso o violencia en el trabajo</span>
            <span class="den-via__p">
              Acoso laboral, acoso sexual y violencia en el trabajo (Ley Karin). También puede presentarla en la
              Inspección del Trabajo.
            </span>
            <span class="den-via__nota">Va con su nombre</span>
            <span class="den-via__ir" aria-hidden="true">Ir al formulario →</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="pn-sec pn-sec--gris" aria-labelledby="den-pasos-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Qué pasa después" titulo="Cómo se revisa su denuncia" id="den-pasos-t" />
      <ol class="den-pasos">
        {pasos.map((p, i) => (
          <li>
            <span class="den-pasos__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
      <p class="den-pend">
        <Pendiente texto="quién recibe y revisa las denuncias (por ejemplo, un encargado de prevención de delitos o un comité), a qué correo llegan y en qué plazo se responde" bloque />
      </p>
    </div>
  </section>

  <section class="pn-sec" aria-labelledby="den-form-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Formularios" titulo="Hacer una denuncia" id="den-form-t" />
      <div class="den-forms">
        <div class="pn-form-caja" id="etica">
          <FormDenunciaEtica privacidadHref={privacidad} />
        </div>
        <div class="pn-form-caja" id="karin">
          <FormDenunciaKarin privacidadHref={privacidad} />
        </div>
      </div>
    </div>
  </section>

  <section class="pn-sec pn-sec--gris" aria-labelledby="den-otras-t">
    <div class="wrap den-otras">
      <div id="seguimiento">
        <h2 class="den-h2" id="den-seg-t">Consultar su denuncia</h2>
        <form class="form den-consulta" id="form-seguimiento" aria-labelledby="den-seg-t">
          <div class="form__fila">
            <div class="campo">
              <label for="seg-folio">Folio</label>
              <input id="seg-folio" name="folio" type="text" autocomplete="off" required aria-describedby="seg-folio-ayuda" />
              <p id="seg-folio-ayuda" class="campo__ayuda">Por ejemplo, D-2026-0001</p>
            </div>
            <div class="campo">
              <label for="seg-clave">Contraseña</label>
              <input id="seg-clave" name="clave" type="password" autocomplete="current-password" required />
            </div>
          </div>
          <button class="btn btn--verde" type="submit">Consultar <span aria-hidden="true">→</span></button>
          <p class="form__estado" id="seg-estado" role="status" tabindex="-1" hidden></p>
        </form>
      </div>
      <div>
        <h2 class="den-h2" id="den-otras-t">Otras vías y documentos</h2>
        <ul class="den-lista">
          <li>
            <strong>Inspección del Trabajo.</strong> Las denuncias de acoso laboral, acoso sexual o violencia en el
            trabajo también se pueden presentar ahí:{' '}
            <a href="https://www.dt.gob.cl/" rel="noopener" target="_blank">dt.gob.cl<span class="visually-hidden"> (abre en otra pestaña)</span></a>.
          </li>
          <li><strong>Por correo.</strong> <Pendiente texto="correo del canal de denuncias" /></li>
          <li>
            <strong>Documentos.</strong>{' '}
            <Pendiente texto="Código de Ética, Modelo de Prevención de Delitos y Reglamento Interno con el procedimiento de la Ley Karin, si existen" />
          </li>
        </ul>
        <p class="den-legal">
          Este texto es un borrador: lo debe revisar quien vea lo legal en la empresa. Cómo se tratan sus datos:
          {' '}<a href={privacidad}>política de privacidad</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('form-seguimiento') as HTMLFormElement | null;
  const estado = document.getElementById('seg-estado');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!estado) return;
    estado.textContent = 'Esto es una propuesta: todavía no hay denuncias que consultar. En el sitio final, aquí vería el estado de su caso y las respuestas.';
    estado.hidden = false;
    estado.focus();
  });
</script>
