---
// Maquinaria y capacidad técnica (datos en src/data/equipos.ts): lo que LOLS tiene en propiedad.
// El mensaje es que la obra no depende de arriendos: cifras reales del inventario de Bóveda y el
// catálogo completo (andamios, alzaprimas y vigas, moldajes, maquinaria, faena y flota).
import { Image } from 'astro:assets';
import Base from '../Base.astro';
import PageBanner from '../components/PageBanner.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import CtaFoto from '../components/CtaFoto.astro';
import Pendiente from '../../comun/Pendiente.astro';
import Revisar from '../../comun/Revisar.astro';
import SinFoto from '../../comun/SinFoto.astro';
import { diapositivas } from '../../../data/portada';
import { cifrasEquipos, catalogo, lineas, maquinaria, flota, flotaMarcas, fuenteEquipos } from '../../../data/equipos';

const banner = diapositivas[4];
const unidades = (n: number) => (n === 1 ? '1 unidad' : `${n} unidades`);
const faena = lineas[3];
const indice = [
  ...catalogo.map((g) => ({ id: g.id, titulo: g.titulo })),
  { id: 'maquinaria', titulo: 'Maquinaria' },
  { id: 'faena', titulo: 'Faena' },
  { id: 'flota', titulo: 'Vehículos' },
];
---
<Base title="Maquinaria y equipos" description="Maquinaria, andamios, alzaprimas, moldajes y vehículos propios de LOLS Ingeniería.">
  <PageBanner titulo="Maquinaria y capacidad técnica" img={banner.img} referencial={banner.credito ?? undefined}>
    <p>Trabajamos con equipos propios: la obra no espera un arriendo para avanzar.</p>
  </PageBanner>

  <section class="pn-sec" aria-labelledby="eq-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Capacidad técnica" titulo="Equipos propios para su obra" id="eq-t">
        <p>
          Andamios, alzaprimas, moldajes, maquinaria y vehículos son de LOLS. Así planificamos cada obra con lo que
          ya tenemos, sin depender de terceros.
        </p>
        <p class="pn-serv-nota solo-marca"><Revisar nota={`cifras del ${fuenteEquipos}; confirmar que se puedan publicar`} /></p>
      </TituloSeccion>
    </div>
    <div class="pn-cifras pn-cifras--borde">
      <div class="wrap">
        <dl class="pn-cifras__grid">
          {cifrasEquipos.map((c) => (
            <div class="pn-cifras__item">
              <dt>{c.texto}</dt>
              <dd><span aria-hidden="true">{c.valor}</span><span class="visually-hidden">{c.leido}</span></dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
    <div class="wrap">
      <ul class="pn-chips eq-indice" aria-label="Ir a una sección">
        {indice.map((s) => <li><a href={`#${s.id}`}>{s.titulo}</a></li>)}
      </ul>
    </div>
  </section>

  {catalogo.map((g, i) => (
    <section class:list={['pn-sec', 'eq-grupo', { 'pn-sec--gris': i % 2 === 0 }]} id={g.id} aria-labelledby={`${g.id}-t`}>
      <div class="wrap">
        <TituloSeccion antetitulo="Equipos propios" titulo={g.titulo} id={`${g.id}-t`}>
          <p>{g.resumen}</p>
        </TituloSeccion>
        <ul class="eq-familias">
          {g.familias.map((f) => (
            <li class="eq-familia">
              <figure class="eq-foto">
                {f.foto ? (
                  <Image src={f.foto} alt={f.nombre} widths={[360, 720]} sizes="(max-width: 600px) 50vw, 280px" />
                ) : (
                  <><Pendiente texto="foto" /><SinFoto /></>
                )}
              </figure>
              <h3>{f.nombre}</h3>
              <p class="eq-familia__n">{f.cantidad}</p>
              {f.medidas && <p class="eq-familia__medidas">{f.medidas}</p>}
              <p class="eq-familia__txt">{f.texto}</p>
            </li>
          ))}
        </ul>
        <p class="eq-nota">Fotos del catálogo interno: algunas son de nuestros equipos y otras son referenciales.</p>
      </div>
    </section>
  ))}

  <section class="pn-sec" id="maquinaria" aria-labelledby="maq-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Equipos propios" titulo="Maquinaria" id="maq-t">
        <p>Para bombear hormigón, mover carga, trabajar en altura y preparar la enfierradura en la misma obra.</p>
      </TituloSeccion>
      <ul class="eq-maquinas">
        {maquinaria.map((m) => (
          <li class="eq-maquina">
            <figure class="eq-foto">
              {m.foto ? (
                <>
                  <Image src={m.foto.src} alt={m.foto.alt} widths={[360, 720]} sizes="(max-width: 600px) 50vw, 280px" />
                  <figcaption class="cubo__ref">Imagen referencial</figcaption>
                </>
              ) : (
                <><Pendiente texto="foto" /><SinFoto /></>
              )}
            </figure>
            <h3>{m.nombre}</h3>
            <p class="eq-maquina__n">{unidades(m.cantidad)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pn-sec pn-sec--gris" id="faena" aria-labelledby="faena-t">
    <div class="wrap eq-faena">
      <figure class="eq-foto eq-foto--real">
        <Image src={faena.foto.src} alt={faena.foto.alt} widths={[600, 1200]} sizes="(max-width: 900px) 100vw, 560px" />
        <figcaption class="cubo__ref">Foto real</figcaption>
      </figure>
      <div>
        <TituloSeccion antetitulo="Equipos propios" titulo={faena.titulo} id="faena-t" centrado={false} />
        <p class="eq-linea__cifra">{faena.cifra}</p>
        <p class="eq-faena__txt">{faena.texto}</p>
      </div>
    </div>
  </section>

  <section class="pn-directrices" id="flota" aria-labelledby="flota-t">
    <div class="wrap eq-flota">
      <TituloSeccion antetitulo="Flota" titulo="Vehículos propios" id="flota-t" claro centrado={false}>
        <p>Para mover personal, materiales y equipos entre la bodega y cada obra. {flotaMarcas}</p>
      </TituloSeccion>
      <ul class="eq-flota__n">
        {flota.map((f) => (
          <li><span class="pn-directrices__n">{f.valor}</span> {f.texto}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pn-sec pn-sec--gris solo-marca" aria-label="Fotos de los equipos">
    <div class="wrap">
      <Pendiente
        texto="una sesión de fotos en bodega de los equipos y la flota, y confirmar cuáles fotos del catálogo son de equipos propios"
        bloque
      />
    </div>
  </section>

  <CtaFoto />
</Base>
