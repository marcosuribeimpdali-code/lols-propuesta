---
// Capacidad técnica (datos en src/data/equipos.ts): lo que LOLS hace con equipos propios.
// Como en las constructoras de referencia, se muestra por USO y con fotos en obra, con pocas cifras
// grandes; el detalle pieza por pieza (unidades y medidas) se envía a solicitud para licitaciones.
import { Image } from 'astro:assets';
import Base from '../Base.astro';
import { r } from '../config';
import PageBanner from '../components/PageBanner.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import CtaFoto from '../components/CtaFoto.astro';
import Pendiente from '../../comun/Pendiente.astro';
import Revisar from '../../comun/Revisar.astro';
import { cifrasEquipos, ventajas, ventajasRevisar, usos, fotoBanner, fotoBodega } from '../../../data/equipos';
---
<Base title="Capacidad técnica" description="Moldajes, alzaprimas, andamios, maquinaria y vehículos propios de LOLS Ingeniería.">
  <PageBanner titulo="Capacidad técnica" img={fotoBanner.src} referencial={fotoBanner.credito ?? undefined}>
    <p>Moldajes, alzaprimas, andamios, maquinaria y vehículos propios: cada obra parte con lo que ya tenemos.</p>
  </PageBanner>

  <section class="pn-sec eq-intro" aria-labelledby="eq-t">
    <div class="wrap pn-dos">
      <div class="pn-dos__txt">
        <TituloSeccion antetitulo="Medios propios" titulo="Construimos con equipos que son nuestros" id="eq-t" centrado={false} />
        <p class="pn-grande">
          Los moldajes, alzaprimas, andamios, la maquinaria y los vehículos con que trabajamos son de LOLS. No
          dependemos de un arriendo para empezar ni para avanzar.
        </p>
        <p>
          Cuando una obra termina, los equipos vuelven a nuestra bodega, se revisan y quedan listos para la
          siguiente. Así planificamos cada proyecto sabiendo con qué contamos.
        </p>
      </div>
      <figure class="pn-dos__img eq-dos__img">
        <Image src={fotoBodega.src} alt={fotoBodega.alt} widths={[600, 1200]} sizes="(max-width: 900px) 100vw, 560px" />
        {fotoBodega.credito && <figcaption class="cubo__ref">Imagen referencial · {fotoBodega.credito}</figcaption>}
      </figure>
    </div>
    <div class="pn-cifras pn-cifras--borde">
      <div class="wrap">
        <dl class="pn-cifras__grid">
          {cifrasEquipos.map((c) => (
            <div class="pn-cifras__item">
              <dt>{c.texto}</dt>
              <dd><span aria-hidden="true">{c.valor}</span><span class="visually-hidden">{c.leido}</span></dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="pn-directrices" aria-labelledby="vent-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Por qué importa" titulo="Ventajas de trabajar con equipos propios" id="vent-t" claro>
        <p class="solo-marca"><Revisar nota={ventajasRevisar} /></p>
      </TituloSeccion>
      <ol class="pn-directrices__grid">
        {ventajas.map((v, i) => (
          <li>
            <span class="pn-directrices__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{v.titulo}</h3>
            <p>{v.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="pn-sec" aria-labelledby="usos-t">
    <div class="wrap">
      <TituloSeccion antetitulo="En obra" titulo="Lo que hacemos con nuestros equipos" id="usos-t" />
      <div class="eq-usos">
        {usos.map((u, i) => (
          <article class:list={['pn-franja', { 'pn-franja--inv': i % 2 === 1 }]} id={u.id} aria-labelledby={`${u.id}-t`}>
            <figure class="pn-franja__foto">
              <Image src={u.foto.src} alt={u.foto.alt} widths={[640, 1100]} sizes="(max-width: 900px) 100vw, 620px" />
              <figcaption class="cubo__ref">
                {u.foto.real ? 'Foto real' : `Imagen referencial${u.foto.credito ? ` · ${u.foto.credito}` : ''}`}
              </figcaption>
            </figure>
            <div class="pn-franja__txt">
              <p class="pn-franja__ante"><span class="pn-franja__n">{String(i + 1).padStart(2, '0')}</span> {u.antetitulo}</p>
              <h3 class="pn-franja__t" id={`${u.id}-t`}>{u.titulo}</h3>
              <p class="pn-franja__desc">{u.texto}</p>
              <h4 class="pn-franja__h">Con qué lo hacemos</h4>
              <ul class="pn-checks">
                {u.equipos.map((e) => <li>{e}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pn-sec pn-sec--gris eq-licita-sec" aria-labelledby="lic-t">
    <div class="wrap">
      <div class="eq-licita">
        <div>
          <h2 id="lic-t" class="eq-licita__t">¿Su licitación pide el listado de equipos?</h2>
          <p>Le enviamos el detalle de moldajes, alzaprimas, andamios, maquinaria y vehículos, con cantidades y medidas.</p>
        </div>
        <a class="btn btn--verde" href={r('contacto')}>Solicitar el listado <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="pn-sec solo-marca" aria-label="Fotos de los equipos">
    <div class="wrap">
      <Pendiente
        texto="fotos de los equipos de LOLS trabajando en obra (moldaje armado, losa apuntalada, andamio de fachada, bomba, flota formada con el logo y la bodega ordenada). Las de ahora son de stock"
        bloque
      />
    </div>
  </section>

  <CtaFoto />
</Base>
