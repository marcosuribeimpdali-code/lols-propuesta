---
// Ficha de una obra: /proyectos-terminados/<slug>/ (el slug de su subpágina en el sitio de 2018),
// /proyectos-en-construccion/<slug>/ y /proyectos-futuros/<slug>/. La arma la ruta única del sitio,
// una por cada obra con `slug`. Las finalizadas y las en ejecución muestran el recorrido con scroll
// (del terreno a la entrega, y el avance hasta el render); los futuros proyectos, el arrastre del
// plano a "así será" y, en vez de galería, el calendario previsto de la obra.
// Arriba, en las finalizadas, el comparador de arrastre (ComparaObra): antes o durante contra el
// después. En las que están en ejecución, el recorrido con scroll (RecorridoObra) con el avance hasta
// el render ("Así quedará").
import { Image } from 'astro:assets';
import Base from '../Base.astro';
import { r, rObra } from '../config';
import TituloSeccion from '../components/TituloSeccion.astro';
import ComparaObra from '../components/ComparaObra.astro';
import RecorridoObra from '../components/RecorridoObra.astro';
import VisorObra from '../components/VisorObra.astro';
import CtaFoto from '../components/CtaFoto.astro';
import Pendiente from '../../comun/Pendiente.astro';
import { conFicha, paginaDe, calendarioPrevisto, type Proyecto } from '../../../data/proyectos';

interface Props {
  obra: string;
}
const { obra } = Astro.props;
const p = conFicha().find((o) => o.slug === obra)!;
const terminada = p.estado === 'terminado';
const futura = p.estado === 'futuro';
// anterior y siguiente, dentro de la misma sección
const lista = conFicha().filter((o) => o.estado === p.estado);
const indice = lista.indexOf(p);
const n = String(indice + 1).padStart(2, '0');
const titulo = p.nombre ?? `Obra ${n}`;
const anterior = lista[(indice - 1 + lista.length) % lista.length];
const siguiente = lista[(indice + 1) % lista.length];
const numero = (o: Proyecto) => String(lista.indexOf(o) + 1).padStart(2, '0');
const seccion = paginaDe[p.estado];
const nombreSeccion = terminada ? 'Proyectos finalizados' : futura ? 'Futuros proyectos' : 'Proyectos en ejecución';
const calendario = futura ? calendarioPrevisto(p) : [];

// ficha de la obra, al pie del recorrido
const datos: [string, string | null][] = terminada
  ? [
      ['Obra', p.nombre],
      ['Mandante', p.mandante],
      ['Año de entrega', p.anio],
      ['Plazo', p.plazo],
      ['Comuna', p.comuna],
      ['Superficie', p.superficie],
      ['Servicios', p.servicios?.join(' · ') ?? null],
    ]
  : [
      ['Obra', p.nombre],
      ['Mandante', p.mandante],
      ['Inicio', p.inicio],
      ['Entrega estimada', p.entregaEstimada],
      ['Comuna', p.comuna],
      ['Superficie', p.superficie],
      ['Servicios', p.servicios?.join(' · ') ?? null],
    ];
const resumen = [
  p.comuna,
  terminada ? p.anio : futura ? p.inicio && `Inicio: ${p.inicio}` : p.entregaEstimada && `Entrega estimada: ${p.entregaEstimada}`,
  p.superficie,
]
  .filter(Boolean)
  .join(' · ');
const hayEjemplos = p.etapas.some((e) => e.ejemplo);
---
<Base
  title={`${titulo} · ${nombreSeccion}`}
  description={
    terminada
      ? `Ficha de la obra ${titulo} de LOLS Ingeniería: del terreno a la entrega.`
      : futura
        ? `${titulo}, proyecto de LOLS Ingeniería que comienza en ${p.inicio}.`
        : `Avance de la obra ${titulo} de LOLS Ingeniería.`
  }
>
  <section class="pn-obra-top" aria-labelledby="obra-t">
    <div class="wrap">
      <nav aria-label="Migas de pan" class="pn-migas">
        <a href={r('inicio')}>Inicio</a> <span aria-hidden="true">›</span>
        <a href={r(seccion)}>{nombreSeccion}</a> <span aria-hidden="true">›</span>
        <span aria-current="page">{titulo}</span>
      </nav>
      <div class="pn-obra-top__cab">
        <h1 id="obra-t">{titulo}</h1>
        <span class:list={['pn-obra-top__estado', { 'pn-obra-top__estado--ejecucion': p.estado === 'en-construccion', 'pn-obra-top__estado--futuro': futura }]}>
          {terminada ? 'Finalizado' : futura ? `Futuro proyecto · inicio ${p.inicio}` : `En ejecución · ${p.avance} % de avance`}
        </span>
        {p.datosEjemplo && <span class="pn-ej">Datos de ejemplo</span>}
      </div>
      {resumen && <p class="pn-obra-top__resumen">{resumen}</p>}

      {futura && p.etapas.length > 1 ? (
        <ComparaObra etapas={p.etapas} titulo={`Del plano a ${titulo}`} antetitulo="Del plano a la obra" />
      ) : (
        <RecorridoObra etapas={p.etapas} titulo={terminada ? `Paso a paso de ${titulo}: del terreno a la entrega` : `Avance de ${titulo}`} />
      )}

      <dl class="pn-obra-ficha">
        {datos.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v ?? <span class="pendiente pendiente--mini">pendiente</span>}</dd>
          </div>
        ))}
        {p.estado === 'en-construccion' && (
          <div class="pn-obra-ficha__avance">
            <dt>Avance</dt>
            <dd>
              <span>{p.avance} %</span>
              <span class="pn-obra__avance-barra" aria-hidden="true"><span style={`width: ${p.avance}%`}></span></span>
            </dd>
          </div>
        )}
      </dl>
      <div class="pn-obra-top__notas">
        {p.datosEjemplo && <Pendiente texto="los datos reales de esta obra: los de ahora son de ejemplo" />}
        {hayEjemplos && (
          <Pendiente
            texto={
              terminada
                ? 'fotos reales de cada etapa: las de ahora son de ejemplo (menos la de la entrega)'
                : futura
                  ? 'plano e imagen del proyecto real: los de ahora son de ejemplo'
                  : 'fotos reales del avance: las de ahora son de ejemplo'
            }
          />
        )}
      </div>
    </div>
  </section>

  {futura ? (
    <section class="pn-sec pn-sec--gris" aria-labelledby="cal-t">
      <div class="wrap">
        <TituloSeccion antetitulo="Calendario previsto" titulo="Así avanzará la obra" id="cal-t">
          <p>Fechas estimadas, sujetas a la firma del contrato y a los permisos.</p>
        </TituloSeccion>
        <ol class="pn-plan">
          {calendario.map((h, i) => (
            <li class="pn-plan__hito">
              <span class="pn-plan__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="pn-plan__fecha">{h.fecha}</span>
              <span class="pn-plan__t">{h.hito}</span>
              <span class="pn-plan__txt">{h.texto}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ) : (
    <section class="pn-sec pn-sec--gris" aria-labelledby="gal-t">
      <div class="wrap">
        <TituloSeccion antetitulo="Registro de la obra" titulo="Galería" id="gal-t">
          <p>Toque una foto para verla en grande.</p>
        </TituloSeccion>
        <VisorObra fotos={[...p.etapas, ...p.galeria]} titulo={titulo} />
      </div>
    </section>
  )}

  <nav class="wrap pn-obra-nav" aria-label="Otras obras">
    <a href={rObra(anterior.slug!, anterior.estado)} class="pn-obra-nav__link">
      {anterior.imagen && <Image src={anterior.imagen.src} alt="" widths={[120]} sizes="96px" />}
      <span><span class="pn-obra-nav__dir">← Obra anterior</span><span class="pn-obra-nav__nombre">{anterior.nombre ?? `Obra ${numero(anterior)}`}</span></span>
    </a>
    <a href={r(seccion)} class="pn-obra-nav__todas">Todas las obras</a>
    <a href={rObra(siguiente.slug!, siguiente.estado)} class="pn-obra-nav__link pn-obra-nav__link--sig">
      <span><span class="pn-obra-nav__dir">Obra siguiente →</span><span class="pn-obra-nav__nombre">{siguiente.nombre ?? `Obra ${numero(siguiente)}`}</span></span>
      {siguiente.imagen && <Image src={siguiente.imagen.src} alt="" widths={[120]} sizes="96px" />}
    </a>
  </nav>

  <CtaFoto />
</Base>
