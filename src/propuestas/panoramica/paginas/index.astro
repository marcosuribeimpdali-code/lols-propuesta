---
import { Image } from 'astro:assets';
import Base from '../Base.astro';
import { r, rObra } from '../config';
import PortadaCubo from '../components/PortadaCubo.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import CtaFoto from '../components/CtaFoto.astro';
import IconoServicio from '../../comun/IconoServicio.astro';
import Pendiente from '../../comun/Pendiente.astro';
import Revisar from '../../comun/Revisar.astro';
import { empresa } from '../../../data/empresa';
import { servicios, revisarDescripciones, fraseServicios } from '../../../data/servicios';
import { porEstado, altObra } from '../../../data/proyectos';
import { lineas, maquinaria } from '../../../data/equipos';

const terminados = porEstado('terminado');

// adelanto de la página de maquinaria: 4 equipos propios
const equiposPortada = [lineas[1].foto, maquinaria[1].foto!, maquinaria[0].foto!, maquinaria[5].foto!];

// "Cómo trabajamos": los mismos pasos que promete la página de contacto
const proceso = [
  { titulo: 'Cuéntenos su proyecto', texto: 'En 3 pasos: el servicio que necesita, los datos de la obra y cómo contactarlo.' },
  { titulo: 'Visita o reunión', texto: 'Conversamos el proyecto en terreno, en oficina o por videollamada.' },
  { titulo: 'Propuesta', texto: 'Le enviamos una propuesta técnica y económica con alcance y plazo.' },
  { titulo: 'Ejecución y entrega', texto: 'Construimos, coordinamos cada etapa y entregamos la obra terminada.' },
];

// cifras bajo la portada: reemplazan los accesos directos, que repetían el menú. "+50" y "+300"
// son lo seguro (no hay registro exacto de las obras de los 30 años); los m² no se saben aún.
const cifras = [
  { valor: String(empresa.anios), leido: String(empresa.anios), texto: 'años en la construcción' },
  { valor: `+${empresa.cifras.obras}`, leido: `más de ${empresa.cifras.obras}`, texto: 'obras realizadas' },
  { valor: `+${empresa.cifras.trabajadores}`, leido: `más de ${empresa.cifras.trabajadores}`, texto: 'trabajadores', revisar: empresa.cifrasRevisar },
  { valor: String(servicios.length), leido: String(servicios.length), texto: 'especialidades' },
];
---
<Base>
  <PortadaCubo />

  <section class="pn-cifras" aria-label={`${empresa.nombreCorto} en cifras`}>
    <div class="wrap">
      <dl class="pn-cifras__grid">
        {cifras.map((c) => (
          <div class="pn-cifras__item">
            <dt>{c.texto}</dt>
            <dd><span aria-hidden="true">{c.valor}</span><span class="visually-hidden">{c.leido}</span></dd>
            {c.revisar && <dd class="pn-cifras__rev"><Revisar nota="cantidad de trabajadores" /></dd>}
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="pn-sec" aria-labelledby="serv-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Lo que hacemos" titulo="Nuestros servicios" id="serv-t">
        <p class="pn-frase">{fraseServicios}</p>
        <p class="pn-serv-nota solo-marca"><Revisar nota={revisarDescripciones} /></p>
      </TituloSeccion>
      <ul class="pn-serv-grid">
        {servicios.map((s) => (
          <li class="pn-serv">
            <span class="pn-serv__icono"><IconoServicio nombre={s.icono} /></span>
            <h3>{s.nombre}</h3>
            <p>{s.corto} <Revisar nota={s.revisar} /></p>
            <a class="pn-link" href={r('servicios', `#${s.slug}`)}>Ver servicio<span class="visually-hidden">: {s.nombre}</span> <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pn-sec pn-sec--gris" aria-labelledby="eqp-t">
    <div class="wrap eq-teaser">
      <div class="eq-teaser__txt">
        <TituloSeccion antetitulo="Capacidad técnica" titulo="Equipos propios" id="eqp-t" centrado={false} />
        <p class="pn-grande">
          Más de 7.000 alzaprimas, 5.000 piezas de andamio, 4.600 m² de moldaje, maquinaria y más de 25 vehículos:
          la obra no espera un arriendo para avanzar.
        </p>
        <a class="btn btn--verde" href={r('maquinaria')}>Ver maquinaria y equipos <span aria-hidden="true">→</span></a>
      </div>
      <ul class="eq-teaser__fotos">
        {equiposPortada.map((f) => (
          <li class="eq-foto">
            <Image src={f.src} alt={f.alt} widths={[300, 600]} sizes="(max-width: 900px) 50vw, 270px" />
          </li>
        ))}
      </ul>
      <p class="eq-teaser__ref">Imágenes referenciales</p>
    </div>
  </section>

  <section class="pn-directrices pn-proceso" aria-labelledby="proc-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Cómo trabajamos" titulo="De la idea a la entrega" id="proc-t" claro>
        <p class="solo-marca"><Revisar nota="pasos del proceso a confirmar con la jefatura" /></p>
      </TituloSeccion>
      <ol class="pn-directrices__grid pn-proceso__grid">
        {proceso.map((p, i) => (
          <li>
            <span class="pn-directrices__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="pn-sec pn-sec--gris" aria-labelledby="obras-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Proyectos" titulo="Obras entregadas" id="obras-t">
        <p class="solo-marca">Fotos del sitio de 2018. <Pendiente texto="nombres y datos de cada obra" /></p>
      </TituloSeccion>
      <ul class="pn-galeria">
        {terminados.map((p, i) => p.imagen && (
          <li>
            <a class="pn-galeria__item" href={p.slug ? rObra(p.slug) : r('terminados')}>
              <Image src={p.imagen.src} alt={altObra(p, i + 1)} widths={[300, 600]} sizes="(max-width: 640px) 50vw, 300px" />
              <span class="pn-galeria__velo" aria-hidden="true">
                <span class="pn-galeria__n">Obra {String(i + 1).padStart(2, '0')}</span>
                <span>Ver obra →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="pn-centro">
        <a class="btn btn--verde" href={r('terminados')}>Ver todos los proyectos <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <CtaFoto />
</Base>
