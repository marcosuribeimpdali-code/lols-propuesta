---
import { Image } from 'astro:assets';
import Base from '../Base.astro';
import { r, rObra } from '../config';
import PortadaCubo from '../components/PortadaCubo.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import CtaFoto from '../components/CtaFoto.astro';
import IconoServicio from '../../comun/IconoServicio.astro';
import Pendiente from '../../comun/Pendiente.astro';
import Revisar from '../../comun/Revisar.astro';
import { empresa } from '../../../data/empresa';
import { servicios, revisarDescripciones } from '../../../data/servicios';

const cuantasEspecialidades = ['Una', 'Dos', 'Tres', 'Cuatro', 'Cinco', 'Seis', 'Siete', 'Ocho'][servicios.length - 1] ?? servicios.length;
import { porEstado, altObra } from '../../../data/proyectos';
import { diapositivas } from '../../../data/portada';

const terminados = porEstado('terminado');
const enConstruccion = porEstado('en-construccion');

// "Cómo trabajamos": los mismos pasos que promete la página de contacto
const proceso = [
  { titulo: 'Cuéntenos su proyecto', texto: 'En 3 pasos: el servicio que necesita, los datos de la obra y cómo contactarlo.' },
  { titulo: 'Visita o reunión', texto: 'Conversamos el proyecto en terreno, en oficina o por videollamada.' },
  { titulo: 'Propuesta', texto: 'Le enviamos una propuesta técnica y económica con alcance y plazo.' },
  { titulo: 'Ejecución y entrega', texto: 'Construimos, coordinamos cada etapa y entregamos la obra terminada.' },
];

// accesos directos bajo la portada (como las 4 tarjetas con foto de la referencia)
const accesos = [
  { titulo: 'Servicios', bajada: `${cuantasEspecialidades} especialidades`, href: r('servicios'), img: diapositivas[1].img, ref: diapositivas[1].credito },
  { titulo: 'Proyectos finalizados', bajada: 'Obras entregadas', href: r('terminados'), img: terminados[2]?.imagen?.src, ref: null },
  { titulo: 'En ejecución', bajada: 'Próximas entregas', href: r('construccion'), img: enConstruccion[3]?.imagen?.src, ref: null },
  { titulo: 'Quiénes somos', bajada: 'Experiencia, seguridad y calidad', href: r('quienes'), img: diapositivas[2].img, ref: diapositivas[2].credito },
];
---
<Base>
  <PortadaCubo />

  <section class="pn-accesos" aria-label="Accesos directos">
    <div class="wrap">
      <ul class="pn-accesos__grid">
        {accesos.map((a) => (
          <li>
            <a class="pn-acceso" href={a.href}>
              {a.img && <Image class="pn-acceso__img" src={a.img} alt="" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 300px" />}
              <span class="pn-acceso__velo" aria-hidden="true"></span>
              <span class="pn-acceso__txt">
                <span class="pn-acceso__bajada">{a.bajada}</span>
                <span class="pn-acceso__titulo">{a.titulo}</span>
                <span class="pn-acceso__ver" aria-hidden="true">Ver más →</span>
              </span>
              {a.ref && <span class="pn-acceso__ref">Imagen referencial</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pn-respaldo" aria-labelledby="resp-t">
    <div class="wrap pn-respaldo__in">
      <h2 id="resp-t" class="pn-respaldo__t">Han confiado en nosotros</h2>
      <ul class="pn-respaldo__logos" aria-label="Logos de mandantes (pendientes)">
        {Array.from({ length: 6 }, () => <li class="pn-respaldo__logo" aria-hidden="true">Logo</li>)}
      </ul>
      <p class="pn-respaldo__pend"><Pendiente texto="logos de mandantes (con su autorización) y certificaciones o registros vigentes, si los hay" /></p>
    </div>
  </section>

  <section class="pn-sec" aria-labelledby="serv-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Lo que hacemos" titulo="Nuestros servicios" id="serv-t">
        <Pendiente texto="frase breve que presente los servicios en conjunto" />
        <p class="pn-serv-nota"><Revisar nota={revisarDescripciones} /></p>
      </TituloSeccion>
      <ul class="pn-serv-grid">
        {servicios.map((s) => (
          <li class="pn-serv">
            <span class="pn-serv__icono"><IconoServicio nombre={s.icono} /></span>
            <h3>{s.nombre}</h3>
            {s.descripcion ? <p>{s.descripcion} <Revisar nota={s.revisar} /></p> : <Pendiente texto="descripción del servicio" />}
            <a class="pn-link" href={r('servicios', `#${s.slug}`)}>Ver servicio<span class="visually-hidden">: {s.nombre}</span> <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pn-directrices pn-proceso" aria-labelledby="proc-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Cómo trabajamos" titulo="De la idea a la entrega" id="proc-t" claro>
        <p><Revisar nota="pasos del proceso a confirmar con la jefatura" /></p>
      </TituloSeccion>
      <ol class="pn-directrices__grid pn-proceso__grid">
        {proceso.map((p, i) => (
          <li>
            <span class="pn-directrices__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
      <div class="pn-centro">
        <a class="btn btn--lima" href={r('contacto')}>Cuéntenos su proyecto <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="pn-sec pn-sec--gris" aria-labelledby="obras-t">
    <div class="wrap">
      <TituloSeccion antetitulo="Proyectos" titulo="Obras entregadas" id="obras-t">
        <p>Fotos del sitio de 2018. <Pendiente texto="nombres y datos de cada obra" /></p>
      </TituloSeccion>
      <ul class="pn-galeria">
        {terminados.map((p, i) => p.imagen && (
          <li>
            <a class="pn-galeria__item" href={p.slug ? rObra(p.slug) : r('terminados')}>
              <Image src={p.imagen.src} alt={altObra(p, i + 1)} widths={[300, 600]} sizes="(max-width: 640px) 50vw, 300px" />
              <span class="pn-galeria__velo" aria-hidden="true">
                <span class="pn-galeria__n">Obra {String(i + 1).padStart(2, '0')}</span>
                <span>Ver obra →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="pn-centro">
        <a class="btn btn--verde" href={r('terminados')}>Ver todos los proyectos <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <CtaFoto />
</Base>
