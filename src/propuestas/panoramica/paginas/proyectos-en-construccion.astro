---
import Base from '../Base.astro';
import PageBanner from '../components/PageBanner.astro';
import ListadoObras from '../components/ListadoObras.astro';
import CtaFoto from '../components/CtaFoto.astro';
import { diapositivas } from '../../../data/portada';

const banner = diapositivas[4];
---
<Base title="Proyectos en ejecución" description="Obras que LOLS Ingeniería tiene en curso.">
  <PageBanner titulo="Proyectos en ejecución" img={banner.img} referencial={banner.credito ?? undefined} />
  <ListadoObras estado="en-construccion" />
  <CtaFoto />
</Base>
