---
import Base from '../Base.astro';
import PageBanner from '../components/PageBanner.astro';
import ListadoObras from '../components/ListadoObras.astro';
import CtaFoto from '../components/CtaFoto.astro';
import { diapositivas } from '../../../data/portada';

const banner = diapositivas[0];
---
<Base title="Proyectos terminados" description="Obras terminadas por LOLS Ingeniería.">
  <PageBanner titulo="Proyectos terminados" img={banner.img} referencial={banner.credito ?? undefined} />
  <ListadoObras estado="terminado" />
  <CtaFoto />
</Base>
