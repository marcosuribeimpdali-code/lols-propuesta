---
import Base from '../Base.astro';
import PageBanner from '../components/PageBanner.astro';
import ListadoObras from '../components/ListadoObras.astro';
import CtaFoto from '../components/CtaFoto.astro';
import { dron } from '../../../data/dron';

const banner = dron.edificioGruaRoja;
---
<Base title="Proyectos finalizados" description="Obras finalizadas por LOLS Ingeniería.">
  <PageBanner titulo="Proyectos finalizados" img={banner.img} referencial={banner.credito ?? undefined} />
  <ListadoObras estado="terminado" />
  <CtaFoto />
</Base>
