---
// Portada de new.lols.cl: lista las propuestas para que la jefatura las compare.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from './Base.astro';
import Logo from '../comun/Logo.astro';
import { propuestas } from '../registro';

// capturas opcionales: src/assets/capturas/<slug>.jpg
const capturas = import.meta.glob<ImageMetadata>('../../assets/capturas/*.{jpg,png,webp}', { eager: true, import: 'default' });
const captura = (slug: string) => Object.entries(capturas).find(([k]) => k.includes(`/${slug}.`))?.[1];
---
<Base title="Propuestas de sitio web · LOLS Ingeniería">
  <div class="sel">
    <Logo class="sel__logo" />
    <p class="sel__eyebrow">Propuestas de nuevo sitio para lols.cl · en revisión</p>
    <h1>Elija una propuesta para recorrerla.</h1>
    <p class="sel__lead">
      Las propuestas tienen las mismas páginas y el mismo contenido; cambia solo el diseño. Desde
      cualquier página se puede saltar a la otra propuesta con la barra amarilla de arriba.
    </p>

    <ul class="sel__grid">
      {propuestas.map((p) => {
        const img = captura(p.slug);
        return (
          <li>
            <a class="op" href={`/${p.slug}/`}>
              {img ? (
                <Image class="op__img" src={img} alt={`Portada de la propuesta ${p.nombre}`} widths={[560, 1120]} sizes="(max-width: 900px) 100vw, 560px" />
              ) : (
                <div class="op__sin-img" aria-hidden="true">
                  {p.colores.map((c) => <span style={`background:${c}`} />)}
                </div>
              )}
              <div class="op__body">
                <span class="op__num">Propuesta {p.numero}</span>
                <h2>{p.nombre}</h2>
                <p>{p.resumen}</p>
                <ul class="op__rasgos">
                  {p.rasgos.map((r) => <li>{r}</li>)}
                </ul>
                <div class="op__colores" aria-hidden="true">
                  {p.colores.map((c) => <span style={`background:${c}`} />)}
                </div>
                <span class="op__ver">Ver propuesta <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>

    <p class="sel__nota">
      Sitio de revisión, fuera de los buscadores. Las marcas amarillas <b>[PENDIENTE]</b> señalan
      contenido que falta y <b>⚠ Por confirmar</b>, datos que hay que validar.
    </p>
  </div>
</Base>
