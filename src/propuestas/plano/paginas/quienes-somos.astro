---
import Base from '../Base.astro';
import PageHero from '../components/PageHero.astro';
import FotoPendiente from '../components/FotoPendiente.astro';
import Pendiente from '../../comun/Pendiente.astro';
import Revisar from '../../comun/Revisar.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaContacto from '../components/CtaContacto.astro';
import { empresa } from '../../../data/empresa';
---
<Base title="Quiénes somos" description="LOLS Ingeniería Limitada: experiencia, seguridad y calidad son nuestras directrices.">
  <PageHero titulo="Quiénes somos" seccion="Quiénes somos">
    <p>{empresa.razonSocial}. {empresa.experiencia.valor}</p>
    <p><Revisar nota={empresa.experiencia.revisar} /></p>
  </PageHero>

  <section class="section">
    <div class="wrap cita-grid">
      <blockquote class="cita">
        <p>{empresa.directrices}</p>
        <footer>{empresa.nombreCorto}</footer>
      </blockquote>
      <FotoPendiente que="equipo de LOLS en obra" proporcion="4 / 3" medida="mín. 1600 × 1200 px" />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="trabajo-t">
    <div class="wrap">
      <SectionHead num="01" etiqueta="Cómo trabajamos" titulo="Lo que guía cada obra." id="trabajo-t" />
      <ul class="principios">
        <li class="principio">
          <span class="principio__n">01</span>
          <h3>Experiencia</h3>
          <p>{empresa.experiencia.valor}</p>
          <Revisar nota={empresa.experiencia.revisar} />
        </li>
        <li class="principio">
          <span class="principio__n">02</span>
          <h3>Seguridad</h3>
          <p>{empresa.principios[1]}</p>
        </li>
        <li class="principio">
          <span class="principio__n">03</span>
          <h3>Calidad</h3>
          <p>{empresa.principios[0]}</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="falta-t">
    <div class="wrap">
      <SectionHead num="02" etiqueta="Por completar" titulo="Lo que falta para esta página." id="falta-t">
        <p>Secciones sugeridas. Cada una se muestra solo si la empresa tiene el contenido.</p>
      </SectionHead>
      <ul class="pendientes-lista">
        <li>
          <h3>Historia</h3>
          <Pendiente texto="año de fundación, hitos y obras que marcaron la trayectoria" bloque />
        </li>
        <li>
          <h3>Equipo</h3>
          <Pendiente texto="socios o jefaturas que se quieran presentar, con foto y cargo" bloque />
        </li>
        <li>
          <h3>Clientes y mandantes</h3>
          <Pendiente texto="empresas para las que se ha trabajado (con su autorización para nombrarlas)" bloque />
        </li>
        <li>
          <h3>Certificaciones</h3>
          <Pendiente texto="registros, certificaciones o afiliaciones vigentes, si las hay" bloque />
        </li>
      </ul>
    </div>
  </section>

  <CtaContacto />
</Base>
