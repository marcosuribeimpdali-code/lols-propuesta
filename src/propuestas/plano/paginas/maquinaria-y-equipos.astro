---
// Capacidad técnica en la propuesta Plano: mismos datos que Panorámica (por uso, con fotos en obra).
import { Image } from 'astro:assets';
import Base from '../Base.astro';
import PageHero from '../components/PageHero.astro';
import Pendiente from '../../comun/Pendiente.astro';
import { cifrasEquipos, ventajas, usos } from '../../../data/equipos';
---
<Base title="Capacidad técnica" description="Moldajes, alzaprimas, andamios, maquinaria y vehículos propios de LOLS Ingeniería.">
  <PageHero titulo="Capacidad técnica" seccion="Medios propios">
    <p>Moldajes, alzaprimas, andamios, maquinaria y vehículos propios: cada obra parte con lo que ya tenemos.</p>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <ul>
        {cifrasEquipos.map((c) => <li><strong>{c.valor}</strong> {c.texto}</li>)}
      </ul>
      <ol>
        {ventajas.map((v) => <li><strong>{v.titulo}.</strong> {v.texto}</li>)}
      </ol>
      {usos.map((u) => (
        <div>
          <h2>{u.titulo}</h2>
          <Image src={u.foto.src} alt={u.foto.alt} widths={[400]} sizes="400px" style="max-width: 400px;" />
          <p>{u.texto}</p>
          <ul>{u.equipos.map((e) => <li>{e}</li>)}</ul>
        </div>
      ))}
      <Pendiente texto="fotos de los equipos de LOLS en obra: las de ahora son de stock" bloque />
    </div>
  </section>
</Base>
