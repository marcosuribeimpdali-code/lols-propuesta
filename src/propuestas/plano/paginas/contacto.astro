---
import Base from '../Base.astro';
import { r } from '../config';
import PageHero from '../components/PageHero.astro';
import Pendiente from '../../comun/Pendiente.astro';
import Revisar from '../../comun/Revisar.astro';
import FormContacto from '../../comun/FormContacto.astro';
import Mapa from '../../comun/Mapa.astro';
import { empresa, mapas } from '../../../data/empresa';

---
<Base title="Contacto" description="Contacte a LOLS Ingeniería: dirección, teléfono y correo.">
  <PageHero titulo="Contacto" seccion="Contacto">
    <p>Cuéntenos de su proyecto y le responderemos.</p>
  </PageHero>

  <section class="section">
    <div class="wrap contacto-grid">
      <div>
        <h2 class="visually-hidden">Datos de contacto</h2>
        <dl class="datos">
          <div class="dato">
            <dt>Dirección</dt>
            <dd>
              {empresa.direccion.valor}
              <a class="link-flecha" href={mapas.llegar} target="_blank" rel="noopener">Cómo llegar <span aria-hidden="true">↗</span><span class="visually-hidden">(se abre en otra pestaña)</span></a>
              <Revisar nota={empresa.direccion.revisar} />
            </dd>
          </div>
          <div class="dato">
            <dt>Teléfono</dt>
            <dd>
              <a href={empresa.telefonoHref}>{empresa.telefono.valor}</a>
              <Revisar nota={empresa.telefono.revisar} />
            </dd>
          </div>
          <div class="dato">
            <dt>Correo</dt>
            <dd>
              <a href={`mailto:${empresa.correo.valor}`}>{empresa.correo.valor}</a>
              <Revisar nota={empresa.correo.revisar} />
            </dd>
          </div>
          <div class="dato">
            <dt>Horario de atención</dt>
            <dd><Pendiente texto="días y horario" /></dd>
          </div>
        </dl>
        <Mapa class="plano-mapa" />
        <p style="margin-top: 20px;">¿Busca trabajo? <a href={r('trabaja')}>Envíe su CV aquí</a>.</p>
      </div>

      <FormContacto privacidadHref={r('privacidad')} />
    </div>
  </section>
</Base>

