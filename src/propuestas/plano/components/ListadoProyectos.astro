---
// Cuerpo compartido de /proyectos-terminados/ y /proyectos-en-construccion/ (URLs heredadas
// del sitio de 2018, se mantienen para no perder lo que Google ya tiene indexado).
import ProyectoCard from './ProyectoCard.astro';
import Pendiente from '../../comun/Pendiente.astro';
import Revisar from '../../comun/Revisar.astro';
import { porEstado, type Estado } from '../../../data/proyectos';
import { r } from '../config';

interface Props {
  estado: Estado;
}
const { estado } = Astro.props;
const lista = porEstado(estado);
const tabs = [
  { href: r('terminados'), label: 'Finalizados', n: porEstado('terminado').length, activo: estado === 'terminado' },
  { href: r('construccion'), label: 'En ejecución', n: porEstado('en-construccion').length, activo: estado === 'en-construccion' },
  { href: r('futuros'), label: 'Próximos', n: porEstado('futuro').length, activo: estado === 'futuro' },
];
---
<section class="section section--tight">
  <div class="wrap">
    <nav class="tabs" aria-label="Tipo de proyecto">
      {tabs.map((t) => (
        <a href={t.href} aria-current={t.activo ? 'page' : undefined}>
          {t.label}<span class="tabs__n">{String(t.n).padStart(2, '0')}</span>
        </a>
      ))}
    </nav>

    <div class="aviso-obras">
      <p>
        Las imágenes vienen del sitio de 2018, que mostraba estas obras sin datos; son de baja
        resolución y se reemplazan cuando lleguen fotos actuales.
        {estado === 'en-construccion' && <> Las de esta sección son renders, no fotos. </>}
      </p>
      {estado === 'en-construccion' && <p><Revisar nota="son obras de 2018: confirmar si siguen en ejecución" /></p>}
      <Pendiente texto="listado actualizado de obras (lo está reuniendo la jefatura)" bloque />
    </div>

    <div class="proyectos-grid">
      {lista.map((p, i) => <ProyectoCard proyecto={p} numero={i + 1} nivel="h2" />)}
    </div>

    <aside class="ficha-tipo" aria-labelledby="ficha-tipo-t">
      <h2 id="ficha-tipo-t" class="ficha-tipo__t">Qué se necesita por cada obra</h2>
      <ul>
        <li>Nombre de la obra</li>
        <li>Mandante</li>
        <li>Comuna</li>
        <li>Año</li>
        <li>Servicios que hizo LOLS</li>
        <li>Magnitud (m² o plazo)</li>
        <li>Fotos (mín. 1600 × 1200 px)</li>
        <li>Estado: finalizada o en ejecución</li>
      </ul>
    </aside>
  </div>
</section>
